# Rust / cargo
/target
bck/
# `build*` catches stray build dirs...
build*
# ...but a cargo build script is source, and `build*` above would swallow it.
!crates/*/build.rs
out/
temp
temp_*/

# Python (scripts/automation_*.py)
__pycache__/
*.py[cod]

# Packaging
# Windows release output (see .github/workflows/release.yml)
dist/
# Flatpak build scratch
.flatpak-builder
.flatpak-builder/
build-dir
build-dir/
# Generated by package/flatpak/gen-cargo-sources.sh (offline Flatpak vendoring)
package/flatpak/cargo-sources.json

# Editors / IDEs
.vscode/
.idea/
*~
.~lock.*

# OS
.DS_Store
.directory

# LLM/AI tools
.claude/
.cursor/
.copilot/
.aider*
.codeium/
.continue/
