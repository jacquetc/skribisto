# Rust / cargo
/target
bck/
# `build*` catches stray build dirs...
build*
# ...but a cargo build script is source, and `build*` above would swallow it.
!crates/*/build.rs
# ...and so is the Windows packaging script.
!package/windows/build.py
# ...and so is the Linux ARM64 packaging script.
!package/linux-aarch64/build.py
# ...and so is the tool that builds the bundled example projects, whose whole
# source directory starts with the same word. Git does not descend into an
# ignored directory, so the directory itself has to be un-ignored, not its files.
!crates/skrib_format/examples/build_example/
out/
temp
# Local cargo config, deliberately NOT committed. Two things live here, and
# neither belongs in the clone:
#   - `[patch.crates-io]` overlaying teksilo*/text-document onto sibling
#     checkouts (the table is in the README; CI must keep resolving from crates.io).
#   - `mold` as the linker: committing that would make mold a hard requirement,
#     and the failure mode is unkind (`cannot find linker "mold"` at link time,
#     which `cargo check`/`clippy` would never have surfaced).
/.cargo/config.toml
temp_*/

# Python (scripts/automation_*.py)
__pycache__/
*.py[cod]

# Packaging
# Windows release output (see .github/workflows/release.yml)
dist/
# Flatpak build scratch
.flatpak-builder
.flatpak-builder/
build-dir
build-dir/
# The build dir the CI workflow pins (flatpak.yml passes build-dir: flatpak_app),
# so reproducing the CI command locally leaves one here too.
flatpak_app
flatpak_app/
# Local ostree repo written by `flatpak-builder --repo=local-repo`
local-repo
local-repo/
# Generated by package/flatpak/gen-cargo-sources.sh (offline Flatpak vendoring)
package/flatpak/cargo-sources.json

# Editors / IDEs
.vscode/
.idea/
*~
.~lock.*

# OS
.DS_Store
.directory

# LLM/AI tools
.claude/
.cursor/
.copilot/
.aider*
.codeium/
.continue/
