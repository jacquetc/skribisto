# Rust / cargo
/target
bck/
# `build*` catches stray build dirs...
build*
# ...but a cargo build script is source, and `build*` above would swallow it.
!crates/*/build.rs
# ...and so is the Windows packaging script.
!package/windows/build.py
out/
temp
# A local build-speed config, deliberately NOT committed: it selects `mold` as the
# linker, and committing it would make mold a hard requirement for every clone —
# a contributor without it gets `cannot find linker "mold"` at link time, which
# `cargo check`/`clippy` would not have warned them about, since neither links.
# Keep the file, share the recipe (README), bind nobody.
/.cargo/config.toml
temp_*/

# Python (scripts/automation_*.py)
__pycache__/
*.py[cod]

# Packaging
# Windows release output (see .github/workflows/release.yml)
dist/
# Flatpak build scratch
.flatpak-builder
.flatpak-builder/
build-dir
build-dir/
# Generated by package/flatpak/gen-cargo-sources.sh (offline Flatpak vendoring)
package/flatpak/cargo-sources.json

# Editors / IDEs
.vscode/
.idea/
*~
.~lock.*

# OS
.DS_Store
.directory

# LLM/AI tools
.claude/
.cursor/
.copilot/
.aider*
.codeium/
.continue/
