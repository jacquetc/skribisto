    [many] تصل { $count } حاشية سفلية في «{ $path }» كنص عادي: لا تُقرأ الحواشي السفلية من Markdown.
   *[other] تصل { $count } حاشية سفلية في «{ $path }» كنص عادي: لا تُقرأ الحواشي السفلية من Markdown.
}
