   *[other] { $path } تحتفظ بـ { $count } جسماً مدمجاً: رسم بياني، معادلة أو متشابهة، ولا يوجد في مخطوطة يمكن أن تحملها.
}
import-diagnostic-field-flattened = { $count ->
