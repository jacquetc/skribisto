import-document-undo = تراجع
import-diagnostic-file-unreadable = تعذّرت قراءة «{ $path }»: { $detail }. تُستورد الملفات الأخرى مع ذلك.
import-diagnostic-nested-too-deep = لم يُقرأ «{ $path }»: محتواه متداخل بأكثر من { $limit } مستوى. لا يقترب أي مستند حقيقي من ذلك، وقد تؤدي قراءته إلى انهيار Skribisto، لذا استُبعد. تُستورد الملفات الأخرى مع ذلك.
import-diagnostic-archive-too-large = لم يُقرأ «{ $path }»: إنه ملف مضغوط مصمَّم ليتمدد إلى حجم أكبر منه بكثير، وقد يستنفد الذاكرة ويؤدي إلى انهيار Skribisto، لذا استُبعد. تُستورد الملفات الأخرى مع ذلك.
import-diagnostic-lossy-decode = { $count ->
    [zero] فُكّ ترميز كل محارف «{ $path }».
    [one] تعذّر فك ترميز محرف واحد في «{ $path }». أعد حفظ الملف بترميز UTF-8 للاحتفاظ به.
    [two] تعذّر فك ترميز محرفين في «{ $path }». أعد حفظ الملف بترميز UTF-8 للاحتفاظ بهما.
    [few] تعذّر فك ترميز { $count } محارف في «{ $path }». أعد حفظ الملف بترميز UTF-8 للاحتفاظ بها.
    [many] تعذّر فك ترميز { $count } محرفًا في «{ $path }». أعد حفظ الملف بترميز UTF-8 للاحتفاظ بها.
   *[other] تعذّر فك ترميز { $count } محرف في «{ $path }». أعد حفظ الملف بترميز UTF-8 للاحتفاظ بها.
}
import-diagnostic-decoded-from-bom = فُكّ ترميز «{ $path }» على أنه { $detail }، لا UTF-8.
import-diagnostic-empty-file = «{ $path }» فارغ.
import-diagnostic-no-headings = لا عناوين في «{ $path }»، لذا يصل كعنصر واحد.
import-diagnostic-unsupported-format = لا يوجد ما يقرأ ملفات «‎.{ $detail }»، لذا تُخطّي «{ $path }».
import-diagnostic-front-matter-not-flat = البيانات التمهيدية في «{ $path }»: «{ $detail }» ليست قيمة بسيطة فتُخطّيت.
import-diagnostic-footnotes-degraded = { $count ->
    [zero] لا حواشٍ سفلية في «{ $path }».
    [one] تصل حاشية سفلية واحدة في «{ $path }» كنص عادي: لا تُقرأ الحواشي السفلية من Markdown.
    [two] تصل حاشيتان سفليتان في «{ $path }» كنص عادي: لا تُقرأ الحواشي السفلية من Markdown.
    [few] تصل { $count } حواشٍ سفلية في «{ $path }» كنص عادي: لا تُقرأ الحواشي السفلية من Markdown.
    [many] تصل { $count } حاشية سفلية في «{ $path }» كنص عادي: لا تُقرأ الحواشي السفلية من Markdown.
   *[other] تصل { $count } حاشية سفلية في «{ $path }» كنص عادي: لا تُقرأ الحواشي السفلية من Markdown.
}
import-diagnostic-footnote-not-carried = { $count ->
    [zero] نُقلت كل الحواشي السفلية في «{ $path }».
    [one] تعذّر نقل حاشية سفلية واحدة في «{ $path }». نُقلت الأخرى.
    [two] تعذّر نقل حاشيتين سفليتين في «{ $path }». نُقلت الأخرى.
    [few] تعذّر نقل { $count } حواشٍ سفلية في «{ $path }». نُقلت الأخرى.
    [many] تعذّر نقل { $count } حاشية سفلية في «{ $path }». نُقلت الأخرى.
   *[other] تعذّر نقل { $count } حاشية سفلية في «{ $path }». نُقلت الأخرى.
}
import-diagnostic-raw-html-dropped = { $count ->
    [zero] لم تُسقط أي كتلة HTML خام من «{ $path }».
    [one] أُسقطت كتلة HTML خام واحدة من «{ $path }».
    [two] أُسقطت كتلتا HTML خام من «{ $path }».
    [few] أُسقطت { $count } كتل HTML خام من «{ $path }».
    [many] أُسقطت { $count } كتلة HTML خام من «{ $path }».
   *[other] أُسقطت { $count } كتلة HTML خام من «{ $path }».
}
import-diagnostic-nested-break-dropped = { $count ->
    [zero] لم يُسقط أي فاصل مشهد من «{ $path }».
    [one] أُسقط فاصل مشهد واحد داخل اقتباس أو قائمة في «{ $path }». لا يُحتفظ إلا بالفاصل الموجود في سطر مستقل.
    [two] أُسقط فاصلا مشهد داخل اقتباسات أو قوائم في «{ $path }». لا يُحتفظ إلا بالفاصل الموجود في سطر مستقل.
    [few] أُسقطت { $count } فواصل مشاهد داخل اقتباسات أو قوائم في «{ $path }». لا يُحتفظ إلا بالفاصل الموجود في سطر مستقل.
    [many] أُسقط { $count } فاصل مشهد داخل اقتباسات أو قوائم في «{ $path }». لا يُحتفظ إلا بالفاصل الموجود في سطر مستقل.
   *[other] أُسقط { $count } فاصل مشهد داخل اقتباسات أو قوائم في «{ $path }». لا يُحتفظ إلا بالفاصل الموجود في سطر مستقل.
}
import-diagnostic-image-not-ingested-format = في «{ $path }»، الصورة «{ $detail }» بصيغة لا يستطيع Skribisto عرضها، لذا استُبعدت. تُستورد الصور بصيغ PNG وJPEG وWebP وGIF وTIFF وBMP؛ احفظها بإحدى هذه الصيغ وأدرجها بنفسك.
import-diagnostic-image-not-ingested-remote = في «{ $path }»، الصورة «{ $detail }» موجودة على الويب. لا تُنزَّل الصور أبدًا أثناء الاستيراد، لذا استُبعدت.
import-diagnostic-image-not-ingested-outside = في «{ $path }»، الصورة «{ $detail }» خارج المستند ومجلده، لذا استُبعدت. لا تُستورد إلا الصور المخزّنة في المستند نفسه أو في مجلده.
import-diagnostic-image-not-ingested-missing = في «{ $path }»، تعذّر العثور على الصورة «{ $detail }»، لذا استُبعدت.
import-diagnostic-image-not-ingested-too-large = في «{ $path }»، الصورة «{ $detail }» أكبر مما يقبله المشروع، لذا استُبعدت.
import-diagnostic-image-not-ingested-unreadable = في «{ $path }»، تعذّرت قراءة «{ $detail }» كصورة، لذا استُبعدت.
import-diagnostic-image-not-ingested-heading = في «{ $path }»، الصورة «{ $detail }» داخل عنوان داخلي. يصبح كل عنوان داخلي عنوانَ عنصر في الحافظة، وعنوان العنصر لا يحمل صورًا، لذا استُبعدت الصورة.
import-diagnostic-image-not-ingested-note = في «{ $path }»، الصورة «{ $detail }» داخل حاشية سفلية أو حاشية ختامية أو تعليق. تحتفظ هذه بكلماتها دون صور، لذا استُبعدت.
import-diagnostic-image-not-ingested-html = في «{ $path }»، الصورة «{ $detail }» مكتوبة بلغة HTML، والاستيراد يستبعد HTML، فاستُبعدت معها. اكتبها كصورة Markdown لتُستورد.
import-diagnostic-image-not-ingested-document-full = في «{ $path }»، استُبعدت الصورة «{ $detail }»: صور هذا المستند مجتمعةً تتجاوز ما يستورده استيراد واحد. استورد المستند على أجزاء، أو أدرج الباقي بنفسك.
import-diagnostic-picture-first-frame-only = في «{ $path }»، تصل الصورة المتحركة «{ $detail }» بإطارها الأول فقط. الصور في المشروع لا تتحرك.
import-diagnostic-duplicate-title = يتكرر «{ $title }» (عدد المرات: { $count }). إن كنت قد استوردت هذه الملفات من قبل، فسيكررها هذا الاستيراد.
import-diagnostic-heading-level-jump = يقفز «{ $title }» من مستوى العنوان { $from } إلى { $to }؛ يوضع مستوى واحدًا تحت العنصر الأب.
import-diagnostic-illegal-combination = يحمل «{ $title }» نصًّا، لكن العنصر من نوع { $kind } لا يتسع لأي نص. يتوقف الاستيراد حتى تغيّر نوعه أو تستبعده. وإلا فلن يُستورد شيء على الإطلاق.
import-diagnostic-tracked-changes-flattened = كان { $path } في منتصف مراجعة: { $count ->
    [zero] لم يُقبل أي تغيير متعقَّب
    [one] قُبل تغيير متعقَّب واحد
    [two] قُبل تغييران متعقَّبان
    [few] قُبلت { $count } تغييرات متعقَّبة
    [many] قُبل { $count } تغييرًا متعقَّبًا
   *[other] قُبل { $count } تغيير متعقَّب
}، وأُسقطت المحذوفات. هذا هو النص النهائي. للاحتفاظ بأي من صياغاتك بدلًا منه، استخدم «مقارنة» في الخطوة الأخيرة.
import-diagnostic-tracked-changes-flattened-by = كان { $path } في منتصف مراجعة: { $count ->
    [zero] لم يُقبل أي تغيير متعقَّب من { $names }
    [one] قُبل تغيير متعقَّب واحد من { $names }
    [two] قُبل تغييران متعقَّبان من { $names }
    [few] قُبلت { $count } تغييرات متعقَّبة من { $names }
    [many] قُبل { $count } تغييرًا متعقَّبًا من { $names }
   *[other] قُبل { $count } تغيير متعقَّب من { $names }
}، وأُسقطت المحذوفات. هذا هو النص النهائي. للاحتفاظ بأي من صياغاتك بدلًا منه، استخدم «مقارنة» في الخطوة الأخيرة.
import-diagnostic-text-box-dropped = { $count ->
    [zero] لا مربعات نص في { $path }.
    [one] يحتوي { $path } على مربع نص واحد. نصه خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا يُستورد.
    [two] يحتوي { $path } على مربعَي نص. نصهما خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا يُستوردان.
    [few] يحتوي { $path } على { $count } مربعات نص. نصها خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا تُستورد.
    [many] يحتوي { $path } على { $count } مربع نص. نصها خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا تُستورد.
   *[other] يحتوي { $path } على { $count } مربع نص. نصها خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا تُستورد.
}
import-diagnostic-embedded-object-dropped = { $count ->
    [zero] لا كائنات مضمّنة في { $path }.
    [one] يحتوي { $path } على كائن مضمّن واحد: مخطط بياني أو معادلة أو ما شابه. لا شيء في المخطوطة يمكنه احتواؤه.
    [two] يحتوي { $path } على كائنين مضمّنين: مخطط بياني أو معادلة أو ما شابه. لا شيء في المخطوطة يمكنه احتواؤهما.
    [few] يحتوي { $path } على { $count } كائنات مضمّنة: مخطط بياني أو معادلة أو ما شابه. لا شيء في المخطوطة يمكنه احتواؤها.
    [many] يحتوي { $path } على { $count } كائنًا مضمّنًا: مخطط بياني أو معادلة أو ما شابه. لا شيء في المخطوطة يمكنه احتواؤها.
   *[other] يحتوي { $path } على { $count } كائن مضمّن: مخطط بياني أو معادلة أو ما شابه. لا شيء في المخطوطة يمكنه احتواؤها.
}
import-diagnostic-field-flattened = { $count ->
    [zero] لا حقول في { $path }.
    [one] يحتوي { $path } على حقل واحد: رقم صفحة أو إحالة مرجعية أو تاريخ. يحتفظ بآخر نص كان يعرضه ولن يتحدّث بعد ذلك.
    [two] يحتوي { $path } على حقلين: رقم صفحة أو إحالة مرجعية أو تاريخ. يحتفظ كل منهما بآخر نص كان يعرضه ولن يتحدّث بعد ذلك.
    [few] يحتوي { $path } على { $count } حقول: رقم صفحة أو إحالة مرجعية أو تاريخ. يحتفظ كل منها بآخر نص كان يعرضه ولن يتحدّث بعد ذلك.
    [many] يحتوي { $path } على { $count } حقلًا: رقم صفحة أو إحالة مرجعية أو تاريخ. يحتفظ كل منها بآخر نص كان يعرضه ولن يتحدّث بعد ذلك.
   *[other] يحتوي { $path } على { $count } حقل: رقم صفحة أو إحالة مرجعية أو تاريخ. يحتفظ كل منها بآخر نص كان يعرضه ولن يتحدّث بعد ذلك.
}
import-diagnostic-unknown-style-level = يستخدم { $path } النمط «{ $detail }»، الذي يبدو عنوانًا لكنه لا يحدد مستوى. تُستورد تلك الفقرات كنص عادي بدلًا من تخمين عمقها.
import-diagnostic-comment-unanchored = تعذّر ربط التعليق «{ $detail }» في { $path } بالكلمات التي يتحدث عنها. يُحتفظ به على عنصره، حيث يمكنك نقله.
import-diagnostic-comment-not-carried = لا يُستورد التعليق «{ $detail }» في { $path }، لأن لا شيء في الملف يصل كنص يمكن الاحتفاظ به عليه. انسخه من الملف إن احتجت إليه.
import-diagnostic-comment-replies-flattened = { $count ->
    [zero] لا ردود يتيمة في { $path }.
    [one] رد واحد في { $path } يشير إلى تعليق غير موجود في الملف، لذا يصل كتعليق مستقل.
    [two] ردان في { $path } يشيران إلى تعليق غير موجود في الملف، لذا يصلان كتعليقين مستقلين.
    [few] { $count } ردود في { $path } تشير إلى تعليق غير موجود في الملف، لذا تصل كتعليقات مستقلة.
    [many] { $count } ردًّا في { $path } تشير إلى تعليق غير موجود في الملف، لذا تصل كتعليقات مستقلة.
   *[other] { $count } رد في { $path } تشير إلى تعليق غير موجود في الملف، لذا تصل كتعليقات مستقلة.
}
import-diagnostic-prose-not-verbatim = { $count ->
    [zero] نُقلت كل فقرات { $path } بتنسيقها.
    [one] تعذّر نقل فقرة واحدة في { $path } بتنسيقها كما كُتبت تمامًا، لذا تصل كنص عادي. قارنها بالأصل.
    [two] تعذّر نقل فقرتين في { $path } بتنسيقهما كما كُتبتا تمامًا، لذا تصلان كنص عادي. قارنهما بالأصل.
    [few] تعذّر نقل { $count } فقرات في { $path } بتنسيقها كما كُتبت تمامًا، لذا تصل كنص عادي. قارنها بالأصل.
    [many] تعذّر نقل { $count } فقرة في { $path } بتنسيقها كما كُتبت تمامًا، لذا تصل كنص عادي. قارنها بالأصل.
   *[other] تعذّر نقل { $count } فقرة في { $path } بتنسيقها كما كُتبت تمامًا، لذا تصل كنص عادي. قارنها بالأصل.
}
import-diagnostic-styled-spaces-not-carried = { $count ->
    [zero] لا مسافات منسّقة في { $path }.
    [one] في { $path }، كان امتداد واحد من المسافات الفارغة مسطّرًا أو يتوسطه خط، كسطر متروك للتعبئة مثلًا. لا يحتفظ Skribisto بأي من الخطين على المسافات وحدها، لذا يصل كمسافات عادية، أو لا يصل إطلاقًا إن كان في بداية فقرة أو نهايتها.
    [two] في { $path }، كان امتدادان من المسافات الفارغة مسطّرين أو يتوسطهما خط، كأسطر متروكة للتعبئة مثلًا. لا يحتفظ Skribisto بأي من الخطين على المسافات وحدها، لذا يصلان كمسافات عادية، أو لا يصلان إطلاقًا إن كانا في بداية فقرة أو نهايتها.
    [few] في { $path }، كانت { $count } امتدادات من المسافات الفارغة مسطّرة أو يتوسطها خط، كأسطر متروكة للتعبئة مثلًا. لا يحتفظ Skribisto بأي من الخطين على المسافات وحدها، لذا تصل كمسافات عادية، أو لا تصل إطلاقًا إن كانت في بداية فقرة أو نهايتها.
    [many] في { $path }، كان { $count } امتدادًا من المسافات الفارغة مسطّرة أو يتوسطها خط، كأسطر متروكة للتعبئة مثلًا. لا يحتفظ Skribisto بأي من الخطين على المسافات وحدها، لذا تصل كمسافات عادية، أو لا تصل إطلاقًا إن كانت في بداية فقرة أو نهايتها.
   *[other] في { $path }، كان { $count } امتداد من المسافات الفارغة مسطّرة أو يتوسطها خط، كأسطر متروكة للتعبئة مثلًا. لا يحتفظ Skribisto بأي من الخطين على المسافات وحدها، لذا تصل كمسافات عادية، أو لا تصل إطلاقًا إن كانت في بداية فقرة أو نهايتها.
}
import-diagnostic-list-nesting-flattened = { $count ->
    [zero] لا عناصر قوائم متداخلة بعمق في { $path } (الحد { $limit }).
    [one] عنصر قائمة واحد في { $path } كان متداخلًا بأكثر من { $limit } مستوى. يصل في المستوى { $limit }، أعمق مستوى يحتفظ به Skribisto، بكلماته وتنسيقه.
    [two] عنصرا قائمة في { $path } كانا متداخلين بأكثر من { $limit } مستوى. يصلان في المستوى { $limit }، أعمق مستوى يحتفظ به Skribisto، بكلماتهما وتنسيقهما.
    [few] { $count } عناصر قوائم في { $path } كانت متداخلة بأكثر من { $limit } مستوى. تصل في المستوى { $limit }، أعمق مستوى يحتفظ به Skribisto، بكلماتها وتنسيقها.
    [many] { $count } عنصر قائمة في { $path } كانت متداخلة بأكثر من { $limit } مستوى. تصل في المستوى { $limit }، أعمق مستوى يحتفظ به Skribisto، بكلماتها وتنسيقها.
   *[other] { $count } عنصر قائمة في { $path } كانت متداخلة بأكثر من { $limit } مستوى. تصل في المستوى { $limit }، أعمق مستوى يحتفظ به Skribisto، بكلماتها وتنسيقها.
}
import-diagnostic-table-read-as-paragraphs = { $count ->
    [zero] لا جداول غير منتظمة في { $path }.
    [one] في { $path } جدول واحد فيه صف أعرض بكثير من البقية، غير منتظم إلى حد لا يسمح بعرضه كشبكة. تصل خلاياه كفقرات متتالية، بكلماتها وتنسيقها.
    [two] في { $path } جدولان فيهما صف أعرض بكثير من البقية، غير منتظمين إلى حد لا يسمح بعرضهما كشبكة. تصل خلاياهما كفقرات متتالية، بكلماتها وتنسيقها.
    [few] في { $path } { $count } جداول فيها صف أعرض بكثير من البقية، غير منتظمة إلى حد لا يسمح بعرضها كشبكة. تصل خلاياها كفقرات متتالية، بكلماتها وتنسيقها.
    [many] في { $path } { $count } جدولًا فيها صف أعرض بكثير من البقية، غير منتظمة إلى حد لا يسمح بعرضها كشبكة. تصل خلاياها كفقرات متتالية، بكلماتها وتنسيقها.
   *[other] في { $path } { $count } جدول فيها صف أعرض بكثير من البقية، غير منتظمة إلى حد لا يسمح بعرضها كشبكة. تصل خلاياها كفقرات متتالية، بكلماتها وتنسيقها.
}
import-diagnostic-spaces-shortened = { $count ->
    [zero] لم تُختصر أي سلسلة مسافات في { $path } (الحد { $limit }).
    [one] سلسلة مسافات واحدة في { $path } تجاوزت { $limit } مسافة، وتصل مختصرة إلى { $limit }. الكلمات المحيطة بها كلها موجودة.
    [two] سلسلتا مسافات في { $path } تجاوزتا { $limit } مسافة، وتصلان مختصرتين إلى { $limit }. الكلمات المحيطة بهما كلها موجودة.
    [few] { $count } سلاسل مسافات في { $path } تجاوزت { $limit } مسافة، وتصل مختصرة إلى { $limit }. الكلمات المحيطة بها كلها موجودة.
    [many] { $count } سلسلة مسافات في { $path } تجاوزت { $limit } مسافة، وتصل مختصرة إلى { $limit }. الكلمات المحيطة بها كلها موجودة.
   *[other] { $count } سلسلة مسافات في { $path } تجاوزت { $limit } مسافة، وتصل مختصرة إلى { $limit }. الكلمات المحيطة بها كلها موجودة.
}
import-diagnostic-epigraph-not-carried = يتصدّر «{ $title }» اقتباسٌ استهلالي، لكن العنصر من نوع { $kind } لا يتسع له. يُحتفظ بالاقتباس في أعلى نصه بدلًا من ذلك.
import-diagnostic-epigraph-placement-ambiguous = يقع اقتباس استهلالي بين «{ $title }» و«{ $below }» ويمكن أن يتصدّر أيًّا منهما. أُعطي لـ«{ $title }»، وهو الموضع المعتاد للاقتباس الاستهلالي.
import-document-diagnostics = { $errors ->
    [0] { $warnings ->
            [zero] لا شيء للتنبيه
            [one] أمر واحد ينبغي معرفته
            [two] أمران ينبغي معرفتهما
            [few] { $warnings } أمور ينبغي معرفتها
            [many] { $warnings } أمرًا ينبغي معرفتها
           *[other] { $warnings } أمر ينبغي معرفتها
        }
   *[other] { $errors ->
            [zero] لا ملفات تعذّرت قراءتها
            [one] تعذّرت قراءة ملف واحد
            [two] تعذّرت قراءة ملفين
            [few] تعذّرت قراءة { $errors } ملفات
            [many] تعذّرت قراءة { $errors } ملفًا
           *[other] تعذّرت قراءة { $errors } ملف
        }
}
import-document-diagnostics-none = لا شيء للإبلاغ عنه.
