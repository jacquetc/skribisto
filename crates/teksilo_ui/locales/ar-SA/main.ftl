import-diagnostic-comment-unanchored = التعليق "{ $detail }" في { $path } لا يمكن أن يُرفق بالكلمات التي كانت حولها، ويُحتفظ به في بنده، حيث يمكنك تحريكه.
import-diagnostic-comment-not-carried = التعليق "{ $detail }" في { $path } ليس مستورداً لأن لا شيء في الملف يصل كنص يمكن الاحتفاظ به
import-diagnostic-comment-replies-flattened = { $count ->
    [one] { $count } الرد الوارد في { $path } يورد تعليقاً غير وارد في الملف، وبالتالي فهو يصل كتعليق خاص به.
   *[other] { $count } وردت في { $path }، ووردت تعليقات غير واردة في الملف، وبذلك تصل هذه الردود كتعليقات من تلقاء نفسها.
}
import-diagnostic-prose-not-verbatim = { $count ->
