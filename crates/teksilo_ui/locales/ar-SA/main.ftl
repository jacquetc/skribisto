}
import-diagnostic-image-not-ingested = يشير «{ $path }» إلى الصورة «{ $detail }». تصل الإشارة كنص؛ أما الصورة نفسها فلا تُنسخ.
import-diagnostic-duplicate-title = يتكرر «{ $title }» (عدد المرات: { $count }). إن كنت قد استوردت هذه الملفات من قبل، فسيكررها هذا الاستيراد.
import-diagnostic-heading-level-jump = يقفز «{ $title }» من مستوى العنوان { $from } إلى { $to }؛ يوضع مستوى واحدًا تحت العنصر الأب.
import-diagnostic-illegal-combination = يحمل «{ $title }» نصًّا، لكن العنصر من نوع { $kind } لا يتسع لأي نص. يتوقف الاستيراد حتى تغيّر نوعه أو تستبعده. وإلا فلن يُستورد شيء على الإطلاق.
import-diagnostic-tracked-changes-flattened = كان { $path } في منتصف مراجعة: { $count ->
    [zero] لم يُقبل أي تغيير متعقَّب
    [one] قُبل تغيير متعقَّب واحد
    [two] قُبل تغييران متعقَّبان
    [few] قُبلت { $count } تغييرات متعقَّبة
    [many] قُبل { $count } تغييرًا متعقَّبًا
   *[other] قُبل { $count } تغيير متعقَّب
}، وأُسقطت المحذوفات. هذا هو النص النهائي. للاحتفاظ بأي من صياغاتك بدلًا منه، استخدم «مقارنة» في الخطوة الأخيرة.
import-diagnostic-tracked-changes-flattened-by = كان { $path } في منتصف مراجعة: { $count ->
    [zero] لم يُقبل أي تغيير متعقَّب من { $names }
    [one] قُبل تغيير متعقَّب واحد من { $names }
    [two] قُبل تغييران متعقَّبان من { $names }
    [few] قُبلت { $count } تغييرات متعقَّبة من { $names }
    [many] قُبل { $count } تغييرًا متعقَّبًا من { $names }
   *[other] قُبل { $count } تغيير متعقَّب من { $names }
}، وأُسقطت المحذوفات. هذا هو النص النهائي. للاحتفاظ بأي من صياغاتك بدلًا منه، استخدم «مقارنة» في الخطوة الأخيرة.
import-diagnostic-text-box-dropped = { $count ->
    [zero] لا مربعات نص في { $path }.
    [one] يحتوي { $path } على مربع نص واحد. نصه خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا يُستورد.
    [two] يحتوي { $path } على مربعَي نص. نصهما خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا يُستوردان.
    [few] يحتوي { $path } على { $count } مربعات نص. نصها خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا تُستورد.
    [many] يحتوي { $path } على { $count } مربع نص. نصها خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا تُستورد.
   *[other] يحتوي { $path } على { $count } مربع نص. نصها خارج تدفق المستند، فلا يمكن تحديد موضعه في المخطوطة. لا تُستورد.
}
import-diagnostic-embedded-object-dropped = { $count ->
