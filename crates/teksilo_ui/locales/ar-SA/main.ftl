    [one] { $count } التغير الذي تم تعقبه { $names } قُبل
   *[other] { $count } التغييرات التي تم تعقبها { $names } قُبل
} هذا هو النص النهائي لإبقاء أي من صيغتك الخاصة بدلاً من ذلك، استخدام المقارنات في الخطوة الأخيرة
