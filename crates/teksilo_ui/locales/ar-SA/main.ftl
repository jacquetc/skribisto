overview-col-status = الحالة
overview-status-mixed = الأجزاء الداخلية مختلفة
help-concept-status = الحالة
status-completion-title = أين وصل الكتاب
status-completion-headline = المشاهد المنتهية: { $done } من { $total }
status-completion-empty = لا مشاهد بعد. يقرأ هذا المخطوطة، فيمتلئ مع تقدمك في الكتابة.
status-completion-open = أين وصل الكتاب…
settings-page-statuses = الحالات
settings-desc-statuses = إعادة تسمية المراحل التي يمر بها المشهد وترتيبها وإضافتها وإزالتها
settings-statuses-add = إضافة حالة
settings-statuses-add-placeholder = اسم الحالة الجديدة
settings-statuses-desc =
    المراحل التي يمر بها المشهد، بالترتيب، من الأقل اكتمالًا في الأعلى إلى الأكثر
    اكتمالًا في الأسفل. هذا الترتيب هو ما تعنيه «أقل اكتمالًا من» في كل مكان آخر
    في التطبيق، لذا رتّبها كما تسير عمليتك فعلًا.
settings-statuses-apply-preset = تطبيق إعداد مسبق…
settings-statuses-preset-applied = { $added ->
    [zero] لم تُضف أي حالة
    [one] أُضيفت حالة واحدة
    [two] أُضيفت حالتان
    [few] أُضيفت { $added } حالات
    [many] أُضيفت { $added } حالة
   *[other] أُضيفت { $added } حالة
}
settings-statuses-preset-refused = لهذا المشروع سلّم حالات بالفعل. الإعدادات المسبقة لا تملأ إلا سلّمًا فارغًا. احذف أولًا الدرجات التي لا تريدها.
settings-statuses-duplicate = «{ $name }» موجودة في هذا السلّم بالفعل
settings-statuses-added = أُضيفت «{ $name }»
settings-statuses-move-up = نقل لأعلى (أقل اكتمالًا)
settings-statuses-move-down = نقل لأسفل (أكثر اكتمالًا)
settings-statuses-details-placeholder = ما تعنيه هذه المرحلة (اختياري)
settings-statuses-delete = حذف «{ $name }»
settings-statuses-delete-in-use = { $count ->
    [zero] حذف «{ $name }»
    [one] حذف «{ $name }»: عنصر واحد يحملها وسيفقد حالته
    [two] حذف «{ $name }»: عنصران يحملانها وسيفقدان حالتهما
    [few] حذف «{ $name }»: { $count } عناصر تحملها وستفقد حالتها
    [many] حذف «{ $name }»: { $count } عنصرًا تحملها وستفقد حالتها
   *[other] حذف «{ $name }»: { $count } عنصر تحملها وستفقد حالتها
}
settings-statuses-deleted = حُذفت «{ $name }»
settings-statuses-deleted-in-use = { $count ->
    [zero] حُذفت «{ $name }».
    [one] حُذفت «{ $name }». عنصر واحد لم تعد له حالة.
    [two] حُذفت «{ $name }». عنصران لم تعد لهما حالة.
    [few] حُذفت «{ $name }». { $count } عناصر لم تعد لها حالة.
    [many] حُذفت «{ $name }». { $count } عنصرًا لم تعد لها حالة.
   *[other] حُذفت «{ $name }». { $count } عنصر لم تعد لها حالة.
}
settings-statuses-empty-title = لا سير عمل بعد
settings-statuses-empty-body = تبيّن الحالة مدى تقدم المشهد. أضف حالة أعلاه، أو ابدأ من إعداد مسبق.
status-category-planned = مخطط له
status-category-drafting = قيد الكتابة
status-category-needs-work = يحتاج إلى عمل
status-category-revised = مُراجَع
status-category-final = نهائي

## Long-operation progress (shared::progress_text). The backend reports phase
## codes it cannot translate; these are their labels. `progress-percent` is the
## toast body on its own, `progress-percent-with-label` with the phase after it.
progress-percent = { $percent }%
progress-percent-with-label = { $percent }% · { $label }
progress-import-opening = جارٍ فتح المشروع…
progress-import-outline = جارٍ قراءة المخطط…
progress-import-converting = جارٍ تحويل الفصول والمشاهد…
progress-import-writing = جارٍ كتابة ملف ‎.skrib…
progress-import-done = تم
progress-import-structure = جارٍ تحديد البنية…
progress-export-start = جارٍ البدء…
progress-export-writing = جارٍ الكتابة…
progress-project-reading = جارٍ قراءة المشروع…
# Settings: the open project's section title, "Work: <its title>".
settings-sec-work-titled = المشروع: { $title }

## Project-import notices (shared::import_warnings::notices): one line of the
## Plume / Manuskript warnings list each. $file, $folder, $title, $name, $field
## and $error are data (file names, titles, a parser's own message) and stay as
## they are. $container is "single-file" or "folder"; $kind is "scene", "note",
## "synopsis" or "title".
import-notice-flattened-rich-texts = { $count ->
    [zero] لم يتجاوز تداخل أي نص الحد الذي يتسع له مشروع Skribisto.
    [one] تجاوز تداخل نص واحد الحد الذي يتسع له مشروع Skribisto، فاحتُفظ بكلماته نصًا عاديًا دون تنسيقه.
    [two] تجاوز تداخل نصّين الحد الذي يتسع له مشروع Skribisto، فاحتُفظ بكلماتهما نصًا عاديًا دون تنسيقهما.
    [few] تجاوز تداخل { $count } نصوص الحد الذي يتسع له مشروع Skribisto، فاحتُفظ بكلماتها نصًا عاديًا دون تنسيقها.
    [many] تجاوز تداخل { $count } نصًا الحد الذي يتسع له مشروع Skribisto، فاحتُفظ بكلماتها نصًا عاديًا دون تنسيقها.
   *[other] تجاوز تداخل { $count } نص الحد الذي يتسع له مشروع Skribisto، فاحتُفظ بكلماتها نصًا عاديًا دون تنسيقها.
}
import-notice-free-text-badges = { $count ->
    [zero] لا تبدو أي شارة مشهد نصًا حرًا.
    [one] تبدو شارة مشهد واحدة نصًا حرًا لا قائمة حالات، فاحتُفظ بها تسميةً للعنصر بدلًا من تحويلها إلى وسم.
    [two] تبدو شارتا مشهد مختلفتان نصًا حرًا لا قائمة حالات، فاحتُفظ بهما تسميتين للعناصر بدلًا من تحويلهما إلى وسمين.
    [few] تبدو { $count } شارات مشاهد مختلفة نصًا حرًا لا قائمة حالات، فاحتُفظ بها تسمياتٍ للعناصر بدلًا من تحويلها إلى وسوم.
    [many] تبدو { $count } شارةً مختلفة للمشاهد نصًا حرًا لا قائمة حالات، فاحتُفظ بها تسمياتٍ للعناصر بدلًا من تحويلها إلى وسوم.
   *[other] تبدو { $count } شارة مختلفة للمشاهد نصًا حرًا لا قائمة حالات، فاحتُفظ بها تسمياتٍ للعناصر بدلًا من تحويلها إلى وسوم.
}
import-notice-separator-text-dropped = كان الفاصل «{ $name }» يحتوي على نص، ولا مكان لذلك في مشروع Skribisto؛ فلم يُستورد النص.
import-notice-separator-without-scene = لم يُستورد الفاصل «{ $name }» لأنه لا يسبقه في فصله مشهد يُلحق به.
import-notice-chapter-without-scenes = لا مشاهد في الفصل «{ $name }»، فلم تُستورد فواصله.
import-notice-rich-text-unconverted = تعذّر تحويل بعض النص المنسّق ({ $error })؛ فلم يُستورد.
import-notice-unresolved-cross-link = تعذّر تتبّع رابط إلى مدخل الشخصية رقم { $number }: المدخل مفقود أو كان في سلة المهملات.
import-notice-read-copy = قُرئت نسخة { $container ->
    [single-file] الملف الواحد
   *[folder] المجلد
} من هذا المشروع.
import-notice-read-copy-dated = قُرئت نسخة { $container ->
    [single-file] الملف الواحد
   *[folder] المجلد
} من هذا المشروع، وآخر تعديل لها في { $day }.
import-notice-original-format = هذا المشروع بتنسيق Manuskript الأصلي لعام 2016. قُرئ كاملًا، ولم يُغيَّر فيه شيء.
import-notice-newer-single-file-beside = «{ $file }» أحدث من هذا المجلد ({ $file_day } مقابل { $folder_day }). يترك Manuskript المجلد القديم في مكانه حين ينتقل المشروع إلى وضع الملف الواحد، لذا قد يكون هذا المجلد نسخة متروكة؛ واستيراد ملف ‎.msk بدلًا منه يقرأ النسخة الأحدث.
import-notice-pickle-skipped = تُرك «{ $file }» دون قراءة. إنه ملف pickle بلغة Python، وكان تحميل مثل هذا الملف من ملف مشروع ثغرةً أمنية في Manuskript نفسه (CVE-2021-35196)؛ والإعدادات التي يحملها تفضيلات عرض، لا كتابة.
import-notice-file-unreadable = تعذّرت قراءة «{ $file }» ({ $error }) فتم تخطيه؛ واستُورد كل ما سواه.
import-notice-not-utf8 = «{ $file }» ليس بترميز UTF-8 صالح؛ فاستُبدلت المحارف التي تعذّرت قراءتها بدلًا من إيقاف الاستيراد.
import-notice-table-unreadable = تعذّرت قراءة «{ $file }» ({ $error })؛ فلم يُستورد ما فيه.
import-notice-outline-missing = «{ $file }» مفقود، فلا مخطوطة في هذا المشروع لاستيرادها.
import-notice-outline-unreadable = تعذّرت قراءة «{ $file }» ({ $error })؛ فلم تُستورد أي مخطوطة.
import-notice-named-none-row = يبدأ «{ $file }» بسطر له اسم («{ $name }») في الموضع الذي يضع فيه Manuskript مدخله الفارغ «none». استُبعد هذا السطر، لتحتفظ الأسطر التالية بالأرقام التي تستخدمها المخطوطة.
import-notice-unknown-field = في «{ $file }» حقل لا يعرفه هذا المستورِد، هو «{ $field }». لم يُستورد.
import-notice-colorless-labels = { $count ->
    [zero] لا سطر بلا لون في «{ $file }».
    [one] في «{ $file }» سطر بلا لون. استُورد بلا لون؛ ويتوقف Manuskript عن تحميل المشروع عند سطر كهذا.
    [two] في «{ $file }» سطران بلا لون. استُوردا بلا لون؛ ويتوقف Manuskript عن تحميل المشروع عند سطر كهذا.
    [few] في «{ $file }» { $count } أسطر بلا لون. استُوردت بلا لون؛ ويتوقف Manuskript عن تحميل المشروع عند سطر كهذا.
    [many] في «{ $file }» { $count } سطرًا بلا لون. استُوردت بلا لون؛ ويتوقف Manuskript عن تحميل المشروع عند سطر كهذا.
   *[other] في «{ $file }» { $count } سطر بلا لون. استُوردت بلا لون؛ ويتوقف Manuskript عن تحميل المشروع عند سطر كهذا.
}
import-notice-settings-unreadable = تعذّرت قراءة «{ $file }» ({ $error })؛ فلم تُستورد لغة المشروع.
import-notice-revisions-unreadable = تعذّرت قراءة «{ $file }» ({ $error })؛ فلم يُستورد سجل المشروع، لكن لم يتأثر شيء آخر.
import-notice-foreign-files = { $count ->
    [zero] لا يحتوي هذا المشروع على ملفات من خارج تنسيق Manuskript: { $files }.
    [one] يحتوي هذا المشروع على ملف ليس من تنسيق Manuskript ولم يُستورد: { $files }.
    [two] يحتوي هذا المشروع على ملفين ليسا من تنسيق Manuskript ولم يُستوردا: { $files }.
    [few] يحتوي هذا المشروع على { $count } ملفات ليست من تنسيق Manuskript ولم تُستورد: { $files }.
    [many] يحتوي هذا المشروع على { $count } ملفًا ليست من تنسيق Manuskript ولم تُستورد: { $files }.
   *[other] يحتوي هذا المشروع على { $count } ملف ليست من تنسيق Manuskript ولم تُستورد: { $files }.
}
import-notice-foreign-files-more = يحتوي هذا المشروع على { $count ->
    [two] ملفين
    [few] { $count } ملفات
    [many] { $count } ملفًا
   *[other] { $count } ملف
} ليست من تنسيق Manuskript ولم تُستورد: { $files }، و{ $more ->
    [one] ملف آخر
    [two] ملفان آخران
    [few] { $more } ملفات أخرى
    [many] { $more } ملفًا آخر
   *[other] { $more } ملف آخر
}.
import-notice-not-a-character-file = «{ $file }» ليس ملف شخصية من Manuskript، فاستُبعد.
import-notice-not-a-text-item = «{ $file }» ليس عنصرًا نصيًا من Manuskript، فاستُبعد من المخطط.
import-notice-missing-blank-line = لا سطر فارغًا بعد ترويسة «{ $file }». احتُفظ بحقله الأخير، مع أن Manuskript يفقده.
import-notice-folder-without-metadata = لا يحتوي «{ $folder }» على { $file }، فاستُورد مجلدًا عاديًا يحمل اسم الدليل. أما Manuskript فيتخطى دليلًا كهذا وكل ما فيه.
import-notice-rows-given-ids = { $count ->
    [zero] لكل عناصر المخطط مُعرّفاتها الخاصة.
    [one] لم يكن لعنصر واحد في المخطط مُعرّف خاص به، فأُعطي مُعرّفًا. يُسقط Manuskript عنصرًا كهذا، أو يتوقف عن تحميل المشروع إذا كان مجلدًا.
    [two] لم يكن لعنصرين في المخطط مُعرّف خاص بهما، فأُعطي كلٌّ منهما مُعرّفًا. يُسقط Manuskript عنصرًا كهذا، أو يتوقف عن تحميل المشروع إذا كان مجلدًا.
    [few] كانت { $count } عناصر في المخطط بلا مُعرّف خاص بها، فأُعطي كلٌّ منها مُعرّفًا. يُسقط Manuskript عنصرًا كهذا، أو يتوقف عن تحميل المشروع إذا كان مجلدًا.
    [many] كان { $count } عنصرًا في المخطط بلا مُعرّف خاص به، فأُعطي كلٌّ منها مُعرّفًا. يُسقط Manuskript عنصرًا كهذا، أو يتوقف عن تحميل المشروع إذا كان مجلدًا.
   *[other] كان { $count } عنصر في المخطط بلا مُعرّف خاص به، فأُعطي كلٌّ منها مُعرّفًا. يُسقط Manuskript عنصرًا كهذا، أو يتوقف عن تحميل المشروع إذا كان مجلدًا.
}
import-notice-plots-unreadable = تعذّرت قراءة «{ $file }» ({ $error })؛ فلم تُستورد الحبكات.
import-notice-world-unreadable = تعذّرت قراءة «{ $file }» ({ $error })؛ فلم تُستورد مداخل العالم.
import-notice-world-not-opml = «{ $file }» ليس مستند OPML؛ فلم تُستورد مداخل العالم.
import-notice-text-flattened = نص «{ $title }» متداخل أعمق مما يتسع له مشروع Skribisto؛ فاحتُفظ بكلماته نصًا عاديًا دون تنسيقه.
import-notice-text-unconverted = تعذّر تحويل نص «{ $title }» ({ $error })؛ فاحتُفظ به كما كُتب تمامًا.
import-notice-text-without-file-name = تعذّر إعطاء { $kind ->
    [scene] نص المشهد
    [note] نص الملاحظة
    [synopsis] ملخص
   *[title] عنوان
} «{ $title }» اسمَ ملف، فلم يُستورد.
import-notice-unknown-label = لـ«{ $title }» التسمية { $index }، وهي ليست في قائمة تسميات هذا المشروع. استُورد بلا تسمية.
import-notice-unknown-status = لـ«{ $title }» الحالة { $index }، وهي ليست في قائمة حالات هذا المشروع. استُورد بلا حالة.
import-notice-unknown-point-of-view = يُروى «{ $title }» من خلال شخصية ليست ضمن شخصيات هذا المشروع. لم تُضبط وجهة نظره.
import-notice-unresolved-references = تعذّر حلّ الإحالات في نص «{ $title }» ({ $error })؛ فاحتُفظ بالنص كما حُوِّل، بما فيه علامات الإحالة.
import-notice-custom-icons = { $count ->
    [zero] لم تكن لأي عنصر أيقونة مخصصة.
    [one] كانت لعنصر واحد أيقونة مخصصة. يعطي Skribisto كل عنصر أيقونة نوعه، فلم تُستورد الأيقونة؛ ولم يتغير شيء آخر في العنصر.
    [two] كانت لعنصرين أيقونتان مخصصتان. يعطي Skribisto كل عنصر أيقونة نوعه، فلم تُستورد الأيقونتان؛ ولم يتغير شيء آخر في العنصرين.
    [few] كانت لـ{ $count } عناصر أيقونات مخصصة. يعطي Skribisto كل عنصر أيقونة نوعه، فلم تُستورد الأيقونات؛ ولم يتغير شيء آخر في تلك العناصر.
    [many] كانت لـ{ $count } عنصرًا أيقونات مخصصة. يعطي Skribisto كل عنصر أيقونة نوعه، فلم تُستورد الأيقونات؛ ولم يتغير شيء آخر في تلك العناصر.
   *[other] كانت لـ{ $count } عنصر أيقونات مخصصة. يعطي Skribisto كل عنصر أيقونة نوعه، فلم تُستورد الأيقونات؛ ولم يتغير شيء آخر في تلك العناصر.
}
import-notice-character-colors = { $count ->
    [zero] لم يكن بجانب اسم أي شخصية لون.
    [one] كان بجانب اسم شخصية واحدة لون. يلوّن Skribisto الوسوم لا العناصر، فلم يُستورد اللون؛ أما الشخصية نفسها فاستُوردت.
    [two] كان بجانب اسمَي شخصيتين لون. يلوّن Skribisto الوسوم لا العناصر، فلم تُستورد الألوان؛ أما الشخصيتان نفساهما فاستُوردتا.
    [few] كان بجانب أسماء { $count } شخصيات لون. يلوّن Skribisto الوسوم لا العناصر، فلم تُستورد الألوان؛ أما الشخصيات نفسها فاستُوردت كلها.
    [many] كان بجانب أسماء { $count } شخصيةً لون. يلوّن Skribisto الوسوم لا العناصر، فلم تُستورد الألوان؛ أما الشخصيات نفسها فاستُوردت كلها.
   *[other] كان بجانب أسماء { $count } شخصية لون. يلوّن Skribisto الوسوم لا العناصر، فلم تُستورد الألوان؛ أما الشخصيات نفسها فاستُوردت كلها.
}
import-notice-versions-kept = { $found ->
    [one] سجّل هذا المشروع إصدارًا سابقًا واحدًا
    [two] سجّل هذا المشروع إصدارين سابقين
    [few] سجّل هذا المشروع { $found } إصدارات سابقة
    [many] سجّل هذا المشروع { $found } إصدارًا سابقًا
   *[other] سجّل هذا المشروع { $found } إصدار سابق
}؛ { $kept ->
    [zero] ولم يُحتفظ بأي منها
    [one] واحتُفظ بواحد منها
    [two] واحتُفظ باثنين منها
   *[other] واحتُفظ بـ{ $kept } منها
}، بعد تقليلها بالطريقة نفسها التي يقلّل بها Skribisto سجله. تجدها في لوحة الإصدارات.
import-notice-versions-unplaced = { $count ->
    [zero] لا إصدارات سابقة بلا مكان.
    [one] ينتمي إصدار سابق واحد إلى عنصر لم يعد في المشروع، فتعذّر وضعه في مكانه.
    [two] ينتمي إصداران سابقان إلى عنصر لم يعد في المشروع، فتعذّر وضعهما في مكانهما.
    [few] تنتمي { $count } إصدارات سابقة إلى عنصر لم يعد في المشروع، فتعذّر وضعها في مكانها.
    [many] ينتمي { $count } إصدارًا سابقًا إلى عنصر لم يعد في المشروع، فتعذّر وضعها في مكانها.
   *[other] ينتمي { $count } إصدار سابق إلى عنصر لم يعد في المشروع، فتعذّر وضعها في مكانها.
}

