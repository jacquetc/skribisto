   *[other] { $count } فقرة في { $path } لا يمكن إلغاؤها بصيغتها المكتوبة بالضبط، بحيث تصل إلى نص واضح، ومقارنة بينها وبين النص الأصلي.
}
import-diagnostic-styled-spaces-not-carried = { $count ->
    [one] In { $path }, { $count } extension of blank space was underlined or struck through, a line left to fill in for example. Skribisto keeps neither line on spaces alone, so it arrives as plain spaces, or not at all where it starts or ends a paragraph.
   *[other] In { $path }, { $count } extendes of blank space were underlined or struck through, lines left to fill in for example. Skribisto keeps neither line on spaces alone, so they arrive as plain spaces, or not at all where they start or end a paragraph.
}
import-diagnostic-list-nesting-flattened = { $count ->
    [one] { $count } بند القائمة { $path } تم إغراقه أكثر من { $limit } مستويات عميقة تصل إلى المستوى { $limit }أعمق Skribisto يحافظ على كلماته وشكله
   *[other] { $count } البنود المدرجة في القائمة { $path } تم إغراقها أكثر من { $limit } مستويات عميقة تصل للمستويات { $limit }أعمق Skribisto يحافظون على كلماتهم وشكلهم
}
import-diagnostic-table-read-as-paragraphs = { $count ->
    [one] { $count } Table in { $path } has a row far broader than the rest, too lopsided to lay out as a grid, Its cells arrive as paragraphs, one after another, with their words and formatting.
   *[other] { $count } طاولات في { $path } لها صف أوسع بكثير من بقية الطاولات، متفاوتة جدا بحيث تُظهر كشبكة، وتصل خلاياها، كفقرات، واحدة تلو الأخرى، إلى كلماتها وشكلها.
}
import-diagnostic-spaces-shortened = { $count ->
    [one] { $count } تشغيل مساحات في { $path } كان أطول من { $limit } حيزاً، ووصل إلى { $limit }، والكلمات حولها كلها موجودة.
   *[other] { $count } كانت مساحات مساحات في { $path } أطول من { $limit } مساحة، ووصلت إلى { $limit }، والكلمات حولها كلها موجودة.
}
import-diagnostic-epigraph-not-carried = "{ $title }" يترأسه رسم بياني، ولكن لا يمكن لرقم { $kind } أن يحمل واحداً.
import-diagnostic-epigraph-placement-ambiguous = الشعار يجلس بين "{ $title }" و "{ $below }" ويمكن أن يترأس أيضاً، لقد تم إعطاؤه لـ "{ $title }"
import-document-diagnostics = { $errors ->
    [0] { $warnings ->
            [one] شيء واحد للمعرفة
           *[other] { $warnings } أشياء لمعرفتها
        }
   *[other] { $errors ->
            [one] لا يمكن قراءة ملف واحد
           *[other] { $errors } لم يكن من الممكن قراءة الملفات
        }
}
import-document-diagnostics-none = لا شيء للإبلاغ عنه.

