wm-book = ספר בפרויקט שלך.
wm-book-more = ספר הוא פשוט או כפי שאתה אוהב.סיפור קצר יכול להיות רק כמה [סצינות](:wm-scene). פרויקט ארוך יותר יכול קן [חלקים](:wm-part) ו [פרקים](:wm-chapter) עמוק כמו שאתה רוצה.
wm-part = חלק מקבוצת פרקים.
wm-part-more = חלק אוסף [פרקים](:wm-chapter) תחת כותרת אחת, כמו פרק, הוא פועל עד החלק הבא או סוף [ספר](:wm-book).
wm-chapter = פרק של הספר.
wm-chapter-more = פרק עובר מכאן עד הפרק הבא, הבא [חלק](:wm-part), או [סוף הספר](:wm-end-of-book) זה מגיע בשתי צורות: תיקיית פרק המכילה [סצינות](:wm-scene), או פרק שטוח הנושא את הפרוזה שלו.בחר איזה פרק חדש משתמש בהגדרות, תחת מבנה.
wm-scene = סצנה של פרוזה
wm-scene-more = לכל פריט כתיבה יש שני צדדים: הטקסט הראשי ו- [תקציר](:wm-synopsis) כדי לתכנן יחד.
wm-note = פתק.
wm-note-more = הערה שומרת טקסט ו- [תקציר](:wm-synopsis), כמו [סצנה](:wm-scene), למחקר, בצד, או לתזכורת.כל פריט יכול להיות חלק מהספר המאסף, כולל פתק יושב בתוך [פרק](:wm-chapter).
wm-note-folder = הערה שמחזיקה פריטים אחרים.
wm-note-folder-more = [הערה](:wm-note) המכילה גם פריטים מתחתיו, כך שתוכל לשתף הערות הקשורות לקבוצה יחד.It שומרת לעצמה [תקציר](:wm-synopsis), והפריטים שבפנים שומרים את הטקסט שלהם.
wm-folder = תיקיה ארגונית.
wm-folder-more = מיכל לסידור פריטים בכבל עם זאת מתאים לך.זה נושא [תקציר](:wm-synopsis) אבל לא פרוזה משלה.
wm-end-of-book = מארקים שבהם הספר מסתיים.
wm-end-of-book-more = כל ספר חולק רשימה רצופה אחת, כך שסוף הספר לא נקבע על ידי קינון.סימן זה אומר ש- [ספר](:wm-book) עוצר כאן.
wm-story-bible-entry = הערה מתויגת, מזוהה על הסיפור שלך.
wm-story-bible-entry-more = [הערה](:wm-note) על דמות, מיקום, או כל דבר אחר שראוי להגיש, נוצר עם שם, תגים, כינויים ותבנית התחלה כל צעד אחד.שום דבר בדף לא מבחין בו לאחר מכן, שכן הוא נשאר שם רגיל אתה יכול לקרוא מחדש, להדבק או להמיר כמו כל אחד אחר.
wm-synopsis = סיכום של פריט כתיבה.
wm-synopsis-more = סיכום המצורף לכל פריט כתיבה, בדרך כלל פסקה קצרה, אבל כל עוד אתה רוצה להשתמש בו כדי לתכנן ולנווט לפני שהפרוזה קיימת.זה יושב ליד הטקסט הראשי בעורך.

scene-break-minor = סצינה רגילה נשברת: שינוי של זמן, מקום או נקודת מבט בפרק.
scene-break-minor-more =
    יש הפסקה *שבו אתה שם את זה*, כולל באמצע של [סצנה](:wm-scene). פיצול פרוזה לשני פריטים הוא בחירה ארגונית, כך שהוא אף פעם לא יוצר הפסקה משלו.

    סוג לתוך הפרוזה כמו שלושה סכנות מופרדות על ידי חללים.איך זה הדפסה נקבע על ידי סגנון היצוא, לא על ידי מה שאתה מקליד: כתב יד Shunn קובע את זה כאחד #, נייר סחר כמו dinkus, ורוב צרפתית, גרמנית, ספרדית, ספרדית, רוסית ואיטלקית, כמו פער חשוף ללא שום סימן בכלל.
scene-break-major = חלוקה חזקה יותר: דילוג זמן גדול, או שינוי מכריע של נקודת מבט.
scene-break-major-more =
    אותו רעיון כמו הפסקה של סצינה רגילה, צעד אחד קדימה, להשתמש בו כאשר הפסקה פשוטה תגביל את הקפיצה.

    סוג של # # #, ו מודפס באופן שונה מן השכבה הרגילה על ידי סגנון הייצוא. Shunn פורמט היד הסטנדרטי של כתב היד סטנדרטי קובע אחד נגד # # # # עבור בדיוק את ההבדל הזה. שבו מסורת אין סימן חזק יותר, שני הטיירים להדפיס אותו.
wm-find-in-prose = Skribisto מחפש את הפריט הזה בפרוזה שלך.
wm-find-in-prose-more = הפעל את זה על תגים כי שם דברים שאתה כותב על: דמויות, מקומות, אובייקטים.כל פריט הנושא תג כזה תואם נגד הפרוזה שלך על ידי הכותרת שלה ועל ידי השמות האחרים שאתה נותן את זה, אז כל אחד מהם. [סצנה](:wm-scene) רשימות שמופיעות בו מבלי לקשר כל דבר ביד. השאירו אותו לתייגים המתארים פריט ולא שם אחד, כגון סטטוס טיוטה או תזכורת לבדיקת המשכיות. [מדריך הסיפור](:wm-story-bible).
wm-story-bible = כל דמות, מקום וכניסה מתויגת אחרת, נאספה ברשת אחת.
wm-story-bible-more = פתוח מקבוצת כרטיסיות משלה של תיקיה. Cards על ידי תג, וכל אחד מהם שם כמה מפרש תשובות כניסה וכמה סצינות הוא הופיע, נמשך מכל תג [למצוא Prose](:wm-find-in-prose) בפרויקט.מסנן על ידי ספר רק צרים שמופיעים כרטיסים; זה אף פעם לא מחליט אילו ערכים קיימים.

tooltip-go-to = לקפוץ לכל פריט בכבל (Ctrl+G)
synopsis-collapse-tooltip = עקבו אחרי synopsis

wm-paratext = טקסט שאינו חלק מהסיפור.
wm-paratext-more = הקדמה, מסירות, מילה, קואלופון: כתיבה השייכת לספר, אך לא לגופו. המייצאת בכל מקום שתכניסו אותו, ולעולם לא תיספר בספירת המילים של כתב היד, שם הוא עולה אליכם: מוסכמות שונות על ידי מדינה ומוציא לאור.
wm-paratext-folder = תיקיה ל paratexts
wm-paratext-folder-more = אי שם כדי לשמור על prefaces ו-Afterwords, כך שהם לא לקלל את הכבל.ארגן רק: הוא נושא [תקציר](:wm-synopsis) אבל לא מוסיף שום דבר אל הספר המייצא, אפילו לא את שמו הפרטי.

goal-target = כמה זמן זה אמור להיות.
goal-target-more = הגדר מטרה על כל דבר: [סצנה](:wm-scene), a [פרק](:wm-chapter), a [חלק](:wm-part)הכל, [ספר](:wm-book)כל אחד הוא מספר משלו והוא עומד בפני עצמו, ולכן הגדרת מטרה על פרק שמעולם לא ישנה את הספר שלו, והמטרה של ספר היא אף פעם לא סכום של הפרקים שבתוכו. [התקדמות](:goal-progress) הכל כתוב מתחתיו, השאירו מטרה באפס, והוא פשוט לא מוגדר. [מילים או דמויות](:goal-unit)כל מה שהפרויקט הזה משתמש.
goal-unit = בין אם מדובר בפרויקט זה במילים או בדמויות.
goal-unit-more = בחירה גלובלית בפרויקט, כי יחידת אורך שייכת לכתב היד ולשוק שלה ולא לסעיף אחד: מדד ההוצאה הגרמנית והצרפתית בסימנים, יפנית ב 400-character, סינית על ידי אלף הדמויות, רוב ההוצאה בשפה האנגלית במילים. שני המספרים נשמרים זה לצד ואף אחד מהם לא מומר לתוך השני, כך שהחלפת היחידה מציינת כל [יעד](:goal-target) באיור השני ומחזירה את המטרות הראשונות.
goal-progress = כמה נכתב, נגד המטרה.
goal-progress-explained = חתיכה עם פרוזה משלה נמדדת נגד אורך שלה; מיכל נגד [הכל כתוב מתחתיו](:goal-manuscript-words). הבר חם מאדום דרך אמבר לירוק כפי שהכתיבה נכנסת, ומשתנה שוב פעם את היצירה רץ היטב על מה תוכנן, אשר שווה להבחין כאשר פרק יש אורך כדי להמשיך.
goal-manuscript-words = מה נחשב ככתב היד.
goal-manuscript-words-more = רק פרוזה אשר ייצוא למעשה: [סצינות](:wm-scene) ו [פרקים](:wm-chapter) הנושא את הטקסט שלהם.A [הערה](:wm-note) או [טקסט נלווה](:wm-paratext) אינו חלק מהכתב יד, והוא אף פעם לא נחשב לכל דבר בפח האשפה טיפות החוצה, וכך עושה משהו [לצאת מהיצוא](:goal-exportable).
goal-exportable = פריט זה נשאר מחוץ לייצוא.
goal-exportable-more = אורך משלו עדיין מראה, כי הכתיבה היא עדיין שם, אבל זה נחשב ללא כל מוחלט, בדיוק כפי שהוא יופיע ללא ספר מייצא.יציאה מכולה בחוץ לא משאיר את החלקים בתוכו בחוץ: כל פריט עונה לעצמו, וזה מה ש"עדיף לילדים" לצד מתג זה.
goal-distribute = שתפו את המטרה הזו על פני מה שנמצא בפנים.
goal-distribute-more = מתחלק יעד [הספר](:wm-book) או [חלק](:wm-part) על פני ילדיה המיידיים, כך שהחתיכות מוסיפים לו בדיוק.ב ברירת מחדל היא ממלאת רק את אלה ללא מטרה ועדיין משאירה את המספרים שלך לבד.מה שהיא כותבת הם רגילים [מטרות](:goal-target), חופשי לערוך לאחר מכן וחופשי לנסח בנפרד: זו פעולה אחת, לא הסדר עומד.
goal-subtree-total = מה המטרות הפנימיות מתווסף.
goal-subtree-total-more = עובדה, לא מטרה.פרויקט זה אף פעם לא מתייחס למטרה של מיכל כסכום של אלה שבתוכו, כי כך הדמות של תיקיה בסופו של דבר נעה בכוחות עצמה כאשר סצינה בתוך זה נתון מספר. קו זה פשוט אומר לך מה המספרים שלך מגיעים, כך שתוכל להשוות אותו עם מיכל. [יעד](:goal-target) עצמך, או [חלקו אחד בחוץ](:goal-distribute).
goal-milestone = תאריך להגיע למשהו.
goal-milestone-more = שני סוגים: אחד אומר [ספר](:wm-book) צריך לעמוד על אורך נתון עד תאריך, נקודת מוצא על העקומה שלו.האחר אומר בפרט. [פרק](:wm-chapter) או או [חלק](:wm-part) היה צריך להגיע [המטרה שלו](:goal-target) לאחר מכן, לקרוא את המספר הזה חי במקום לשמור עותק של זה, כך שעריכה את המטרה מעדכנת את אבן הדרך גם כן. [תכנית קצב](:pace-plan).
pace-plan = לוח הזמנים של הספר
pace-plan-more = A A A A [יעד](:goal-target) מועד אחרון, עם הימים שאתה כותב עליהם, הפך לכמה יום צריך.זה קורא את המטרה של הספר עצמו, אז הגדרתו כאן ולהגדיר אותו במפקח הם אותו מספר בשני מקומות. [אבני דרך](:goal-milestone).

concept-tag = תווית צבעוניתקודמת אתה יכול לשים על כל פריט, ניתן לשחזר בכל הפרויקט.
concept-tag-more = הזן פריט כדי לסמן את זה: מצב, מיקום, חוט שאתה מעקב. אותו תג יכול לשבת על כל מספר פריטים, פריט אחד יכול לשאת כמה. Turn על [למצוא Prose](:wm-find-in-prose) עבור תג שמות משהו בספר שלך, דמות או מקום, ו Skribisto מתחיל לחפש אותו בפרוזה שלך.
concept-label = הערה קצרה אתה כותב תחת הכותרת של פריט, עבור העיניים שלך.
concept-label-more = לא [תגית](:concept-tag): תווית שייכת פריט אחד בלבד, טקסט פשוט ללא צבע או קטלוג מאחורי זה, משהו כמו "נקודת העלילה הראשונה" או "need a name" הגדר אותו מתפריט ההקשר של הפריט, או לערוך אותו בשורה בעמודה של הסקירה; זה מראה ככותרת קטנה תחת הכותרת, בתנור ובזרם זהה.
concept-point-of-view = מי שעיניו סצינה מהדהדת: אחת או יותר של סיפורך.
concept-point-of-view-more = הגדר במפקח, לצד הקבוצה, בחירת מישהו עדיין לא בנבחרת מוסיפה אותם שם.יותר ממבט אחד היא בחירה משפטית, שימושית לסצינה משותפת או שינוי של עיניים באמצע הספר, לא משהו. Skribisto מועמדים באים מהפריטים [למצוא Prose](:wm-find-in-prose) תג מופיע בסיפורך התנ"ך.
concept-epigraph = ציטוט על ראשו של חלק או פרק.
concept-epigraph-more = שדה משלו, נפרד מה- [פרק](:wm-chapter) או ה- [חלק](:wm-part) של פרוזה משלו; [סצנה](:wm-scene) או [הערה](:wm-note) אין אף אחד.כתוב אחד כציטוט רגיל; לכתוב כמה וכל אחד הופך למכסה שלו, מודפס כאפיגרף משלו.
concept-footnote = ציטוט המסומן בפרוזה, הדפסה כהערה מספרית.
concept-footnote-more = ההתייחסות היא סימן אחד בתוך המילים שלך, כך שהיא נעה וממחקת בדיוק כמו המילים סביבו.מספרה אינו מאוחסן: Skribisto פרויקטים זה בחוץ טרי מהמקום שבו כל אזכור יושב בכתב היד כולו, אז הוספת מספר חוזר אחד כל פתק לאחר זה. a Footnote המילים של כף הרגל נספרות בנפרד מן כתב היד, אף פעם לא מתקפלים לתוך זה.
concept-chapter-mode = בין אם פרק חדש הוא תיקיה של סצינות או פריט שטוח אחד.
concept-chapter-mode-more = מגדירים בהגדרות, תחת מבנה. בשתי האפשרויות כותבים ישירות ב[פרק](:wm-chapter); ההבדל הוא אם הוא יכול להכיל סצנות. שתי האפשרויות מייצאות אותו ספר וניתן לשלב ביניהן. שינוי הסוג ממיר פרק בלי לאבד טקסט.
concept-comment = הערה מעוגן למתיחה מדויקת של פרוזה, המוצגת בשולי.
concept-comment-more = היא זוכרת את המילים שהיא מצביעה ומה מקיף אותם, לא עמדה קבועה, כך שהיא שורדת עריכה רגילה ועומס מלא.תשובה מתחת כדי לשמור על חוט הולך.אם הציטוט המדויק כבר לא ניתן למצוא, ההערה אומרת כך במקום להסחף בשקט אל המשפט הלא נכון.
concept-backup = עותק של כל הפרויקט, שנשמר לצידו.
concept-backup-more = קח על לוח זמנים שאתה בוחר: על פתוח, קרוב, על מרווח, או כל תערובת, עם עותקים ישנים על ידי גיל או על ידי ספירה.פתח אחד לטעון אותו בחלון שלו: אתה יכול להסתכל ואפילו לערוך, אבל רק לשמור כמו או לשחזר שומר משהו שונה מ [גירסה גירסה](:concept-version), אשר עוקב אחר העבר של פריט אחד.
concept-version = העבר של פריט אחד עצמו: כל שינוי לטקסט שלו או לסנטרופיה שלו.
concept-version-more = נבנה מן ההיסטוריה של הפרויקט עצמו להציל את ההיסטוריה ואת הגיבוי שלה יחד, כניסה אחת לשינוי ולא אחד לקובץ.בחר כניסה כדי לראות מה השתנה ולשחזר רק את הטקסט של פריט זה אליו; שאר הפרויקט הוא בלתי ניתן להשגה, עותק בטיחות נלקח קודם. שונה מ [גיבוי](:concept-backup), שהוא עותק של הכל.
concept-trash = פריט מזוהם מוסתר, לא זז: הוא נשאר בדיוק היכן שהוא היה.
concept-trash-more = Trashing רק מטביע דגל אחד: הפריט שומר את מקומו בכבל, מסומן לא פעיל במקום להסיר. לשחזר אותו והוא מופיע במקום המדויק הזה, ללא כל סינון מחדש לעשות. ריקה מסירת פריטים מזוהמים לטוב, וכל אחד מהם הוא צעד אחד בלתי ניתן לביצוע, כמו כל פרויקט אחר.
concept-spellcheck = במילים אחרות, אין מילון מותקן מזהה, לכל שפת הפרויקט.
concept-spellcheck-more = לכל פרויקט יש שפה או שפות משלו; פריט יכול לעקוף אותם לסצינה שנכתבה בשפה אחרת. הוסף מילה Skribisto לא יודע מתפריט ההקשר של העורך, למילון אישי הנושא את כל פרויקט.
concept-search-replace = מצא מילה או ביטוי בכל מקום בפרויקט, לא רק את המסמך הפתוח.
concept-search-replace-more = מסתכל דרך כל סצנה, הערה, כותרת, סינפסה ולייבל, ובאמצעות הערות והערות שוליים גם.מקרה, התאמה מלאה ומבטא מתאימים הם שלושה מתגים נפרדים. Replace All rewrites כל משחק נבדק במעבר אחד ואחד צעד לא לעשות, כך Ctrl+Z מחזיר את כל החבילה, לא רק את השינוי האחרון.
concept-note-template = יצירה מחודשת של כתיבה שאתה מכניס לתוך כל דבר שאתה עובד עליו.
concept-note-template-more = דף דמות, תיאור מקום או מתווה עלילה: כותבים פעם אחת ומכניסים לכל פריט לפי הצורך. אפשר להתחיל מתבנית מובנית, לייבא קובץ .md או .djot, או לבחור מסמך ▸ שמירה כתבנית. התבניות נשמרות בפרויקט וזמינות גם לשותפים לכתיבה.
concept-text-replacement = היד הקצרה שלך, התרחבה באופן אוטומטי כמו שאתה סוג.
concept-text-replacement-more = הגדר טריגר והחלופה שלו, "btw" עבור "דרך", והוא מרחיב את הרגע שבו אתה מקליד חלל או puncation אחרי זה.מקרה עוקב אחר מה שציפית: לייעל את ההדק ואת ההתרחבות גם. Backspace מיד לאחר התרחבות לא עושים רק כי אחד החלפתם על כל פרויקט, נבדל מהפרויקט. [טיהור חכם](:concept-smart-punctuation).
concept-smart-punctuation = טייפוגרפיה מקומית-מודע שימשה באופן אוטומטי כסוג: ציטוטים, דחיות, אליפס.
concept-smart-punctuation-more = קללס מצטט ישירות לטיפוסים אוטוביוגרפיים, הופך - לתוך א-שאט ו--- לתוך ערימה, הופך... אל תוך אליפסזה, והיכן אתה הופך את זה הלאה, פותח פסקה המכונה "עם דיאלוג dash. Set לכל פרויקט, ונוסע פנימה בתוך הבזיליקה. .skrib כך כותב משותף כותב עם אותם כללים. [הכללים שלך](:concept-text-replacement)מי אתה כותב את עצמך.
concept-export-style = חבילה בשם של אפשרויות ייצוא: כותרות, ספאק, מה הכלול.
concept-export-style-more = סגנון אחד, משוחזר בכל יצוא כל פורמט שתבחר.הסגנונות המובנים לקריאה בלבד; כפול אחד כדי לקבל נקודת התחלה אתה יכול למעשה להשתנות.בין הבחירות שלו הוא בין [האותיות הקטנות של Roundtrip Markers](:concept-round-trip-marks), עבור קובץ הקשור לעורך ובחזרה.
concept-round-trip-marks = הערות ספרים בלתי נראות שאפשרו לעריכת DOCX או ODT חזרו הביתה.
concept-round-trip-marks-more = כתוב רק בשני הפורמטים שעורך יכול לשלוח בחזרה. DOCX ו ODTכל יצוא אחר לא נושא אף אחד.סימן ספר, לא תכונה אישית: LibreOffice פסים תכונות מותאמות אישית על שמירת אבל משאיר סימן ספר שלם. [סגנון יצוא](:concept-export-style)מתחת ל-"Sending to a Editor".
concept-status = כאשר פריט עומד בזרימת העבודה שלך: שלב אחד בכל פעם, קדימה.
concept-status-more = לא [תגית](:concept-tag): פריט יש בדיוק מעמד אחד, השלבים הם הורה, ואת הפרויקט הבעלים של הרשימה, כך שאתה יכול לקרוא מחדש, להזמין או להוסיף אותו בכל פעם שאתה אוהב. An Asteסיכון לצד פרק או ספר פירושו החלקים מתחתיו לא כולם מסכימים עם זה.קבע את זה מן המפקח, כרטיס, פריט, או כאן.
