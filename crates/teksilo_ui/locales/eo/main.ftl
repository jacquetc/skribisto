import-diagnostic-image-not-ingested-format = En «{ $path }», la bildo «{ $detail }» estas en formato, kiun Skribisto ne povas montri, do ĝi estis preterlasita. Bildoj en PNG, JPEG, WebP, GIF, TIFF aŭ BMP importiĝas; konservu ĝin en unu el tiuj formatoj kaj enmetu ĝin permane.
import-diagnostic-image-not-ingested-remote = En «{ $path }», la bildo «{ $detail }» troviĝas en la reto. Importo neniam elŝutas bildojn, do ĝi estis preterlasita.
import-diagnostic-image-not-ingested-outside = En «{ $path }», la bildo «{ $detail }» troviĝas ekster la dokumento kaj ĝia dosierujo, do ĝi estis preterlasita. Importiĝas nur bildoj konservitaj en la dokumento aŭ en la propra dosierujo de la dokumento.
import-diagnostic-image-not-ingested-missing = En «{ $path }», la bildo «{ $detail }» ne troveblis, do ĝi estis preterlasita.
import-diagnostic-image-not-ingested-too-large = En «{ $path }», la bildo «{ $detail }» estas pli granda ol projekto akceptas, do ĝi estis preterlasita.
import-diagnostic-image-not-ingested-unreadable = En «{ $path }», la bildo «{ $detail }» ne legeblis kiel bildo, do ĝi estis preterlasita.
import-diagnostic-image-not-ingested-heading = En «{ $path }», la bildo «{ $detail }» troviĝas en titola alineo. Ĉiu titola alineo fariĝas la titolo de ero en la kolektujo, kaj titolo enhavas neniun bildon, do la bildo estis preterlasita.
import-diagnostic-image-not-ingested-note = En «{ $path }», la bildo «{ $detail }» troviĝas en piednoto, finnoto aŭ komento. Tiuj konservas siajn vortojn sed neniun bildon, do ĝi estis preterlasita.
import-diagnostic-image-not-ingested-html = En «{ $path }», la bildo «{ $detail }» estas skribita en HTML, kaj importo preterlasas HTML, do ankaŭ la bildo estis preterlasita. Skribu ĝin kiel Markdown-bildon por importi ĝin.
import-diagnostic-image-not-ingested-document-full = En «{ $path }», la bildo «{ $detail }» estis preterlasita: la bildoj de ĉi tiu dokumento kune superas tion, kion unu importo akceptas. Importu la dokumenton en partoj, aŭ enmetu la ceterajn permane.
import-diagnostic-picture-first-frame-only = En «{ $path }», la movbildo «{ $detail }» alvenas kiel sia unua kadro. Bildoj en projekto ne moviĝas.
import-diagnostic-duplicate-title = «{ $title }» aperas { $count } fojojn. Se vi jam importis ĉi tiujn dosierojn, tio duplikatos ilin.
import-diagnostic-heading-level-jump = «{ $title }» saltas de titola nivelo { $from } al { $to }; ĝi estas metita unu nivelon sub la enhavanta ero.
import-diagnostic-illegal-combination = «{ $title }» enhavas tekston, sed la tipo { $kind } ne povas enhavi ĝin. Ŝanĝu ĝian tipon aŭ ekskludu ĝin antaŭ importi. Alie nenio importiĝos.
import-diagnostic-tracked-changes-flattened = { $path } estis dum reviziado: { $count ->
    [one] { $count } spurita ŝanĝo estis akceptita
   *[other] { $count } spuritaj ŝanĝoj estis akceptitaj
}, kaj forigita teksto estis forlasita. Tio estas la fina teksto. Por konservi vian propran vortumon, uzu Kompari en la lasta paŝo.
import-diagnostic-tracked-changes-flattened-by = { $path } estis dum reviziado: { $count ->
    [one] { $count } spurita ŝanĝo de { $names } estis akceptita
   *[other] { $count } spuritaj ŝanĝoj de { $names } estis akceptitaj
}, kaj forigita teksto estis forlasita. Tio estas la fina teksto. Por konservi vian propran vortumon, uzu Kompari en la lasta paŝo.
import-diagnostic-text-box-dropped = { $count ->
    [one] { $path } enhavas { $count } tekstujon ekster la dokumenta fluo. Ĝia loko en la manuskripto ne estas determinebla, do ĝi ne importiĝas.
   *[other] { $path } enhavas { $count } tekstujojn ekster la dokumenta fluo. Ilia loko en la manuskripto ne estas determinebla, do ili ne importiĝas.
}
import-diagnostic-embedded-object-dropped = { $count ->
    [one] { $path } enhavas { $count } enkorpigitan objekton: diagramon, ekvacion aŭ similan. La manuskripto ne povas enhavi ĝin.
   *[other] { $path } enhavas { $count } enkorpigitajn objektojn: diagramojn, ekvaciojn aŭ similajn. La manuskripto ne povas enhavi ilin.
}
import-diagnostic-field-flattened = { $count ->
    [one] { $path } enhavas { $count } kampon: paĝnumeron, krucreferencon aŭ daton. Ĝi konservas sian lastan tekston kaj ne plu ĝisdatiĝos.
   *[other] { $path } enhavas { $count } kampojn: paĝnumerojn, krucreferencojn aŭ datojn. Ĉiu konservas sian lastan tekston kaj ne plu ĝisdatiĝos.
}
import-diagnostic-unknown-style-level = { $path } uzas la stilon «{ $detail }», kiu aspektas kiel titolo sed ne havas nivelon. Tiuj alineoj importiĝas kiel ordinara teksto.
import-diagnostic-comment-unanchored = La komento «{ $detail }» en { $path } ne povis esti ligita al sia teksto. Ĝi restas ĉe sia ero, kie vi povas movi ĝin.
import-diagnostic-comment-not-carried = La komento «{ $detail }» en { $path } ne importiĝas, ĉar nenio en la dosiero fariĝas teksto, al kiu ligi ĝin. Kopiu ĝin el la dosiero se vi bezonas ĝin.
import-diagnostic-comment-replies-flattened = { $count ->
    [one] { $count } respondo en { $path } referencis komenton ne ĉeestantan en la dosiero, do ĝi fariĝas aparta komento.
   *[other] { $count } respondoj en { $path } referencis komenton ne ĉeestantan en la dosiero, do ili fariĝas apartaj komentoj.
}
import-diagnostic-prose-not-verbatim = { $count ->
    [one] { $count } alineo en { $path } ne povis esti importita kun sia ĝusta formatado, do ĝi fariĝas simpla teksto. Komparu ĝin kun la originalo.
   *[other] { $count } alineoj en { $path } ne povis esti importitaj kun sia ĝusta formatado, do ili fariĝas simpla teksto. Komparu ilin kun la originalo.
}
import-diagnostic-styled-spaces-not-carried = { $count ->
    [one] En { $path }, { $count } serio de spacoj estis substrekita aŭ trastrekita, ekzemple plenigenda linio. Ĝi importiĝas kiel ordinaraj spacoj, aŭ estas forigita ĉe la komenco aŭ fino de alineo.
   *[other] En { $path }, { $count } serioj de spacoj estis substrekitaj aŭ trastrekitaj, ekzemple plenigendaj linioj. Ili importiĝas kiel ordinaraj spacoj, aŭ estas forigitaj ĉe la komenco aŭ fino de alineo.
}
import-diagnostic-list-nesting-flattened = { $count ->
    [one] { $count } listero en { $path } estis pli profunda ol { $limit } niveloj. Ĝi importiĝas ĉe nivelo { $limit }, la plej profunda subtenata, kun siaj vortoj kaj formatado.
   *[other] { $count } listeroj en { $path } estis pli profundaj ol { $limit } niveloj. Ili importiĝas ĉe nivelo { $limit }, la plej profunda subtenata, kun siaj vortoj kaj formatado.
}
import-diagnostic-table-read-as-paragraphs = { $count ->
    [one] { $count } tabelo en { $path } havas vicon multe pli larĝan ol la aliaj kaj ne aranĝeblas kiel krado. Ĝiaj ĉeloj importiĝas kiel sinsekvaj alineoj, kun siaj vortoj kaj formatado.
   *[other] { $count } tabeloj en { $path } havas vicon multe pli larĝan ol la aliaj kaj ne aranĝeblas kiel krado. Iliaj ĉeloj importiĝas kiel sinsekvaj alineoj, kun siaj vortoj kaj formatado.
}
import-diagnostic-spaces-shortened = { $count ->
    [one] { $count } serio en { $path } havis pli ol { $limit } spacojn kaj mallongiĝis al { $limit }. La ĉirkaŭaj vortoj ĉiuj restas.
   *[other] { $count } serioj en { $path } havis pli ol { $limit } spacojn kaj mallongiĝis al { $limit }. La ĉirkaŭaj vortoj ĉiuj restas.
}
import-diagnostic-epigraph-not-carried = «{ $title }» havas epigrafon, sed la tipo { $kind } ne povas enhavi ĝin. La citaĵo restas ĉe la komenco de ĝia teksto.
import-diagnostic-epigraph-placement-ambiguous = Epigrafo troviĝas inter «{ $title }» kaj «{ $below }» kaj povus aparteni al ambaŭ. Ĝi estis atribuita al «{ $title }», la kutima loko por epigrafo.
import-document-diagnostics = { $errors ->
    [0] { $warnings ->
        [one] 1 rimarko
       *[other] { $warnings } rimarkoj
    }
   *[other] { $errors ->
        [one] 1 dosiero ne povis esti legita
       *[other] { $errors } dosieroj ne povis esti legitaj
    }
}
import-document-diagnostics-none = Nenio raportenda.
