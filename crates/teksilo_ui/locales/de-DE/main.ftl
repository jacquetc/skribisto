project-import-location-readonly = Dieser Ordner ist nicht beschreibbar
project-import-name-required = Geben Sie einen Dateinamen ein
project-import-name-exists = Hier existiert bereits eine Datei mit diesem Namen. Das Überschreiben wird beim Import bestätigt
project-import-name-is-folder = Hier existiert bereits ein Ordner mit diesem Namen, vielleicht ein als Ordner gespeichertes Projekt. Ein Import kann ihn nicht ersetzen: Wählen Sie einen anderen Namen
# Overwrite confirmation
project-import-overwrite-title = Vorhandene Datei ersetzen?
project-import-overwrite-text = „{ $name }“ existiert bereits. Durch das importierte Projekt ersetzen?
# Projects are imported one at a time, whichever importer asks.
project-import-busy-title = Ein anderes Projekt wird gerade importiert
project-import-busy-text = Projekte werden einzeln importiert. Warten Sie auf den Abschluss des laufenden Imports oder brechen Sie ihn ab, und starten Sie diesen dann erneut.
# Spoken by a screen reader once per phase, never shown: the toast's title, then
# the phase's name.
project-import-progress-announcement = { $title } { $phase }
# The notice once Cancel is pressed, until the converter has stopped: it may be
# finishing a file it cannot leave half written.
project-import-stopping = Import wird beendet…
project-import-cancelled = Import abgebrochen
project-import-open-now = Jetzt öffnen
project-import-details = Details
