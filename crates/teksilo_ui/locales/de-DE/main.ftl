import-scrivener-report-chose-enclosing = Sie haben etwas innerhalb von „{ $project }“ gewählt, daher wurde das ganze Projekt importiert.
import-scrivener-report-chose-upgraded = Sie haben „{ $current }“ importiert, das Projekt, in dem Sie weitergeschrieben haben, und nicht die Kopie, die Scrivener vor einer Aktualisierung behalten hat.
import-scrivener-report-chose-backup = Sie haben „{ $backup }“ importiert, die ältere Kopie, die Scrivener vor einer Aktualisierung behalten hat.
import-scrivener-report-title-placeholder-rejected = Der Titel in den Projekteinstellungen war ein Platzhalter aus einer Vorlage, daher hat Skribisto stattdessen den Namen des Projekts vorgeschlagen.
import-scrivener-report-author-placeholder-rejected = Der Autorenname in den Projekteinstellungen war ein Platzhalter aus einer Vorlage, daher hat Skribisto keinen vorgeschlagen.
import-scrivener-report-title-from-compile-settings = Skribisto hat den Titel aus den Kompilierungseinstellungen des Projekts vorgeschlagen: den Namen, den das Projekt bei seiner Erstellung hatte, sofern dort in Scrivener kein Titel festgelegt wurde.
import-scrivener-report-title-from-template = Skribisto hat den eigenen Titel der Vorlage vorgeschlagen.
import-scrivener-report-title-from-folder-name = Skribisto hat den Namen des Projekts als Titel vorgeschlagen.
import-scrivener-report-title-from-project-properties = Skribisto hat den Titel aus den Projekteigenschaften vorgeschlagen.
import-scrivener-report-author-from-project = Skribisto hat den Autorennamen aus den Projekteinstellungen vorgeschlagen. Dort kann noch der Autor einer Vorlage stehen, der dann auf einer Titelseite erscheinen würde.
import-scrivener-report-language-not-stated = Das Projekt gab seine Sprache nicht an, daher hat Skribisto die Sprache seiner eigenen Oberfläche vorgeschlagen. Sie bestimmt, wie Wörter gezählt und Anführungszeichen gesetzt werden.
import-scrivener-report-language-from-script = Skribisto hat die Sprache anhand der Schrift vorgeschlagen, in der das Manuskript geschrieben ist ({ $tag }).
# A proposal of the Save page the writer replaced with their own. $hint is the sentence
