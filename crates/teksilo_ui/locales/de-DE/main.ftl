## What the import does with the keywords, custom metadata, collections, bookmarks, targets,
## the deadline, the auto-complete list and the icons. Each line is said twice: on the Review
## page before the import, then in its report, so it reads the same at both times. `$note`
## and `$folder` are the titles the import gives a note and its "From Scrivener" folder;
## `$day` is a day as YYYY-MM-DD.
import-scrivener-metadata-pov-hint-line = { $count ->
    [1] Das Label oder der Feldwert { $values } entspricht dem Eintrag { $matches } der Geschichtenbibel. Falls er die Erzählperspektive angibt, legen Sie diese im Inspektor fest: Der Import verknüpft nichts.
   *[other] Die Labels oder Feldwerte { $values } entsprechen den Einträgen { $matches } der Geschichtenbibel. Falls sie Erzählperspektiven angeben, legen Sie diese im Inspektor fest: Der Import verknüpft nichts.
}
import-scrivener-metadata-checkbox-default-unknown-line = Das Kontrollkästchenfeld „{ $field }“ hat einen Standardwert, den Skribisto nicht lesen kann, daher lässt sich nicht feststellen, welche Dokumente standardmäßig angehakt sind. Nur die einzeln angehakten Dokumente tragen sein Schlagwort.
import-scrivener-metadata-goals-in-other-unit-line = { $count ->
    [one] 1 Ziel ist in der anderen Zähleinheit festgelegt. Es bleibt erhalten und erscheint, sobald Sie die Zähleinheit unter Einstellungen ▸ Projekt ▸ Struktur umstellen.
   *[other] { $count } Ziele sind in der anderen Zähleinheit festgelegt. Diese bleiben erhalten und erscheinen, sobald Sie die Zähleinheit unter Einstellungen ▸ Projekt ▸ Struktur umstellen.
}
import-scrivener-metadata-counting-differs-line = Scrivener hat das Manuskriptziel über andere Dokumente gezählt als Skribisto. Das Ziel des Buchs zählt die Szenen, die in Exporte eingeschlossen sind.
import-scrivener-metadata-writing-days-not-read-line = Die Schreibtage „{ $raw }“ können nicht gelesen werden, daher zählt das Schreibtempo des Buchs jeden Tag als Schreibtag. Ändern Sie die Schreibtage dort.
import-scrivener-metadata-script-mode-rows-line = { $count ->
    [one] 1 Eintrag war in Scrivener im Skriptmodus. Skribisto behält seine Wörter als Fließtext, ohne das Drehbuchlayout.
   *[other] { $count } Einträge waren in Scrivener im Skriptmodus. Skribisto behält ihre Wörter als Fließtext, ohne das Drehbuchlayout.
}
import-scrivener-metadata-keywords-became-tags-line = { $tags ->
    [one] 1 Schlüsselwort wird zu einem Schlagwort, vergeben an { $rows ->
        [one] { $rows } Eintrag
       *[other] { $rows } Einträge
    }.
   *[other] { $tags } Schlüsselwörter werden zu Schlagwörtern, vergeben an { $rows ->
        [one] { $rows } Eintrag
       *[other] { $rows } Einträge
    }.
}
import-scrivener-metadata-keyword-hierarchy-flattened-line = { $count ->
    [one] 1 Schlüsselwort lag in Scrivener innerhalb eines anderen. Schlagwörter sind nicht verschachtelt: Die Details seines Schlagworts geben an, wo es lag.
   *[other] { $count } Schlüsselwörter lagen in Scrivener innerhalb anderer. Schlagwörter sind nicht verschachtelt: Die Details jedes Schlagworts geben an, wo sein Schlüsselwort lag.
}
# $fields list or checkbox fields become $tags tags; $rows is how many items wear those
# tags. Nest the selectors as your grammar needs.
import-scrivener-metadata-fields-became-tags-line = { $fields ->
    [one] 1 Listen- oder Kontrollkästchenfeld wird zu { $tags ->
        [one] { $tags } Schlagwort
       *[other] { $tags } Schlagwörtern
    }, vergeben an { $rows ->
        [one] { $rows } Eintrag
       *[other] { $rows } Einträge
    }.
   *[other] { $fields } Listen- und Kontrollkästchenfelder werden zu { $tags ->
        [one] { $tags } Schlagwort
       *[other] { $tags } Schlagwörtern
    }, vergeben an { $rows ->
        [one] { $rows } Eintrag
       *[other] { $rows } Einträge
    }.
}
