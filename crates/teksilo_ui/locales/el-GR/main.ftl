## Project-import notices (shared::import_warnings::notices): one line of the
## Plume / Manuskript warnings list each. $file, $folder, $title, $name, $field
## and $error are data (file names, titles, a parser's own message) and stay as
## they are. $container is "single-file" or "folder"; $kind is "scene", "note",
## "synopsis" or "title".
import-notice-flattened-rich-texts = { $count ->
    [one] Ένα κείμενο ήταν εμφωλευμένο βαθύτερα απ' όσο χωράει ένα έργο του Skribisto· οι λέξεις του διατηρήθηκαν ως απλό κείμενο, χωρίς τη μορφοποίησή τους.
   *[other] { $count } κείμενα ήταν εμφωλευμένα βαθύτερα απ' όσο χωράει ένα έργο του Skribisto· οι λέξεις τους διατηρήθηκαν ως απλό κείμενο, χωρίς τη μορφοποίησή τους.
}
import-notice-free-text-badges = { $count ->
    [one] Ένα σήμα σκηνής μοιάζει με ελεύθερο κείμενο και όχι με λίστα καταστάσεων, γι' αυτό διατηρήθηκε ως λεζάντα του στοιχείου αντί να γίνει ετικέτα.
   *[other] { $count } διαφορετικά σήματα σκηνών μοιάζουν με ελεύθερο κείμενο και όχι με λίστα καταστάσεων, γι' αυτό διατηρήθηκαν ως λεζάντες στοιχείων αντί να γίνουν ετικέτες.
}
import-notice-separator-text-dropped = Το διαχωριστικό «{ $name }» περιείχε κείμενο, που δεν έχει θέση σε ένα έργο του Skribisto· το κείμενο δεν εισήχθη.
import-notice-separator-without-scene = Το διαχωριστικό «{ $name }» δεν είχε πριν από αυτό καμία σκηνή στο κεφάλαιό του για να προσαρτηθεί, γι' αυτό δεν εισήχθη.
import-notice-chapter-without-scenes = Το κεφάλαιο «{ $name }» δεν έχει σκηνές, γι' αυτό τα διαχωριστικά του δεν εισήχθησαν.
import-notice-rich-text-unconverted = Ένα μέρος του μορφοποιημένου κειμένου δεν μπόρεσε να μετατραπεί ({ $error })· δεν εισήχθη.
import-notice-unresolved-cross-link = Ένας σύνδεσμος προς το πρόσωπο #{ $number } δεν μπόρεσε να ακολουθηθεί: η καταχώριση λείπει ή βρισκόταν στον κάδο.
import-notice-read-copy = Διαβάστηκε το αντίγραφο αυτού του έργου { $container ->
    [single-file] σε ένα μόνο αρχείο
   *[folder] σε φάκελο
}.
import-notice-read-copy-dated = Διαβάστηκε το αντίγραφο αυτού του έργου { $container ->
    [single-file] σε ένα μόνο αρχείο
   *[folder] σε φάκελο
}, με τελευταία αλλαγή στις { $day }.
import-notice-original-format = Αυτό το έργο είναι στην αρχική μορφή του Manuskript του 2016. Διαβάστηκε ολόκληρο· τίποτα σε αυτό δεν άλλαξε.
import-notice-newer-single-file-beside = Το «{ $file }» είναι νεότερο από αυτόν τον φάκελο ({ $file_day } έναντι { $folder_day }). Το Manuskript αφήνει τον παλιό φάκελο στη θέση του όταν ένα έργο περνά σε λειτουργία ενός αρχείου, οπότε αυτός ο φάκελος ίσως είναι ένα εγκαταλελειμμένο αντίγραφο· αν εισαγάγετε στη θέση του το αρχείο .msk, θα διαβαστεί το νεότερο.
import-notice-pickle-skipped = Το «{ $file }» δεν διαβάστηκε. Είναι ένα pickle της Python, και η φόρτωσή του από αρχείο έργου ήταν κενό ασφαλείας του ίδιου του Manuskript (CVE-2021-35196)· οι ρυθμίσεις που περιέχει αφορούν την εμφάνιση, όχι τη γραφή.
import-notice-file-unreadable = Το «{ $file }» δεν μπόρεσε να διαβαστεί ({ $error }) και παραλείφθηκε· όλα τα υπόλοιπα εισήχθησαν.
import-notice-not-utf8 = Το «{ $file }» δεν είναι έγκυρο UTF-8· οι χαρακτήρες που δεν μπόρεσαν να διαβαστούν αντικαταστάθηκαν, αντί να διακοπεί η εισαγωγή.
import-notice-table-unreadable = Το «{ $file }» δεν μπόρεσε να διαβαστεί ({ $error })· το περιεχόμενό του δεν εισήχθη.
import-notice-outline-missing = Το «{ $file }» λείπει, οπότε αυτό το έργο δεν έχει χειρόγραφο για εισαγωγή.
import-notice-outline-unreadable = Το «{ $file }» δεν μπόρεσε να διαβαστεί ({ $error })· δεν εισήχθη κανένα χειρόγραφο.
import-notice-named-none-row = Το «{ $file }» ξεκινά με μια επώνυμη γραμμή («{ $name }») εκεί όπου το Manuskript κρατά την κενή του καταχώριση «none». Παραλείφθηκε, ώστε οι γραμμές που ακολουθούν να κρατήσουν τους αριθμούς που χρησιμοποιεί το χειρόγραφο.
import-notice-unknown-field = Το «{ $file }» έχει ένα πεδίο που αυτός ο εισαγωγέας δεν γνωρίζει, το «{ $field }». Δεν εισήχθη.
import-notice-colorless-labels = { $count ->
    [one] Το «{ $file }» έχει μια γραμμή χωρίς χρώμα. Εισήχθη χωρίς χρώμα· το Manuskript σταματά να φορτώνει το έργο σε μια τέτοια γραμμή.
   *[other] Το «{ $file }» έχει { $count } γραμμές χωρίς χρώμα. Εισήχθησαν χωρίς χρώμα· το Manuskript σταματά να φορτώνει το έργο σε μια τέτοια γραμμή.
}
import-notice-settings-unreadable = Το «{ $file }» δεν μπόρεσε να διαβαστεί ({ $error })· η γλώσσα του έργου δεν εισήχθη.
import-notice-revisions-unreadable = Το «{ $file }» δεν μπόρεσε να διαβαστεί ({ $error })· το ιστορικό του έργου δεν εισήχθη, αλλά τίποτε άλλο δεν επηρεάστηκε.
import-notice-foreign-files = { $count ->
    [one] Αυτό το έργο περιέχει ένα αρχείο που δεν ανήκει στη μορφή του Manuskript και δεν εισήχθη: { $files }.
   *[other] Αυτό το έργο περιέχει { $count } αρχεία που δεν ανήκουν στη μορφή του Manuskript και δεν εισήχθησαν: { $files }.
}
import-notice-foreign-files-more = Αυτό το έργο περιέχει { $count } αρχεία που δεν ανήκουν στη μορφή του Manuskript και δεν εισήχθησαν: { $files } και { $more ->
    [one] ένα ακόμη
   *[other] { $more } ακόμη
}.
import-notice-not-a-character-file = Το «{ $file }» δεν είναι αρχείο χαρακτήρα του Manuskript και παραλείφθηκε.
import-notice-not-a-text-item = Το «{ $file }» δεν είναι στοιχείο κειμένου του Manuskript και έμεινε εκτός διάρθρωσης.
import-notice-missing-blank-line = Το «{ $file }» δεν έχει κενή γραμμή μετά την κεφαλίδα του. Το τελευταίο του πεδίο διατηρήθηκε, αν και το Manuskript το χάνει.
import-notice-folder-without-metadata = Ο φάκελος «{ $folder }» δεν έχει { $file }, γι' αυτό εισήχθη ως απλός φάκελος με το όνομα του καταλόγου. Το Manuskript παραλείπει έναν τέτοιο κατάλογο και ό,τι περιέχει.
import-notice-rows-given-ids = { $count ->
    [one] Μια γραμμή της διάρθρωσης δεν είχε δικό της αναγνωριστικό (ID) και της δόθηκε ένα. Το Manuskript απορρίπτει μια τέτοια γραμμή ή, αν είναι φάκελος, σταματά να φορτώνει το έργο.
   *[other] { $count } γραμμές της διάρθρωσης δεν είχαν δικό τους αναγνωριστικό (ID) και τους δόθηκε από ένα. Το Manuskript απορρίπτει μια τέτοια γραμμή ή, αν είναι φάκελος, σταματά να φορτώνει το έργο.
}
import-notice-plots-unreadable = Το «{ $file }» δεν μπόρεσε να διαβαστεί ({ $error })· οι πλοκές δεν εισήχθησαν.
import-notice-world-unreadable = Το «{ $file }» δεν μπόρεσε να διαβαστεί ({ $error })· οι καταχωρίσεις του κόσμου δεν εισήχθησαν.
import-notice-world-not-opml = Το «{ $file }» δεν είναι έγγραφο OPML· οι καταχωρίσεις του κόσμου δεν εισήχθησαν.
import-notice-text-flattened = Το κείμενο του «{ $title }» είναι εμφωλευμένο βαθύτερα απ' όσο χωράει ένα έργο του Skribisto· οι λέξεις του διατηρήθηκαν ως απλό κείμενο, χωρίς τη μορφοποίησή τους.
import-notice-text-unconverted = Το κείμενο του «{ $title }» δεν μπόρεσε να μετατραπεί ({ $error })· διατηρήθηκε ακριβώς όπως γράφτηκε.
import-notice-text-without-file-name = Δεν ήταν δυνατό να δοθεί όνομα αρχείου { $kind ->
    [scene] στο κείμενο σκηνής
    [note] στο κείμενο σημείωσης
    [synopsis] στη σύνοψη
   *[title] στον τίτλο
} του «{ $title }», γι' αυτό δεν εισήχθη.
import-notice-unknown-label = Το «{ $title }» έχει τη λεζάντα { $index }, που δεν υπάρχει στη λίστα λεζαντών αυτού του έργου. Εισήχθη χωρίς λεζάντα.
import-notice-unknown-status = Το «{ $title }» έχει την κατάσταση { $index }, που δεν υπάρχει στη λίστα καταστάσεων αυτού του έργου. Εισήχθη χωρίς κατάσταση.
import-notice-unknown-point-of-view = Το «{ $title }» αφηγείται μέσα από έναν χαρακτήρα που δεν ανήκει στα πρόσωπα αυτού του έργου. Η οπτική γωνία του δεν ορίστηκε.
import-notice-unresolved-references = Οι παραπομπές στο κείμενο του «{ $title }» δεν μπόρεσαν να επιλυθούν ({ $error })· το κείμενο διατηρήθηκε όπως μετατράπηκε, μαζί με τα σημάδια των παραπομπών.
import-notice-custom-icons = { $count ->
    [one] Μια γραμμή είχε προσαρμοσμένο εικονίδιο. Το Skribisto δίνει σε κάθε γραμμή το εικονίδιο του τύπου της, γι' αυτό το εικονίδιο δεν εισήχθη· τίποτε άλλο στη γραμμή δεν άλλαξε.
   *[other] { $count } γραμμές είχαν προσαρμοσμένο εικονίδιο. Το Skribisto δίνει σε κάθε γραμμή το εικονίδιο του τύπου της, γι' αυτό τα εικονίδια δεν εισήχθησαν· τίποτε άλλο σε αυτές τις γραμμές δεν άλλαξε.
}
import-notice-character-colors = { $count ->
    [one] Ένας χαρακτήρας είχε χρώμα δίπλα στο όνομά του. Το Skribisto χρωματίζει τις ετικέτες, όχι τις γραμμές, γι' αυτό το χρώμα δεν εισήχθη· ο ίδιος ο χαρακτήρας εισήχθη.
   *[other] { $count } χαρακτήρες είχαν χρώμα δίπλα στο όνομά τους. Το Skribisto χρωματίζει τις ετικέτες, όχι τις γραμμές, γι' αυτό τα χρώματα δεν εισήχθησαν· οι ίδιοι οι χαρακτήρες εισήχθησαν όλοι.
}
import-notice-versions-kept = { $found ->
    [one] Αυτό το έργο είχε καταγράψει μία προηγούμενη έκδοση
   *[other] Αυτό το έργο είχε καταγράψει { $found } προηγούμενες εκδόσεις
}· { $kept ->
    [one] διατηρήθηκε μία
   *[other] διατηρήθηκαν { $kept }
}, αραιωμένες όπως αραιώνει το Skribisto το δικό του ιστορικό. Βρίσκονται στον πίνακα «Εκδόσεις».
import-notice-versions-unplaced = { $count ->
    [one] Μία προηγούμενη έκδοση ανήκει σε μια γραμμή που δεν υπάρχει πια στο έργο και δεν μπόρεσε να τοποθετηθεί.
   *[other] { $count } προηγούμενες εκδόσεις ανήκουν σε μια γραμμή που δεν υπάρχει πια στο έργο και δεν μπόρεσαν να τοποθετηθούν.
}

