# Words the exporter writes into a book in this language. See en.ftl.

heading-book = Livro { $n }
heading-part = Parte { $n }
heading-chapter = Capítulo { $n }
heading-word-book = Livro
heading-word-part = Parte
heading-word-chapter = Capítulo
byline = de { $author }
word-count-note = cerca de { $count } palavras
digit-group-separator = { "." }
