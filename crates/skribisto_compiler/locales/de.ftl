# Words the exporter writes into a book in this language. See en.ftl.

heading-book = Buch { $n }
heading-part = Teil { $n }
heading-chapter = Kapitel { $n }
heading-word-book = Buch
heading-word-part = Teil
heading-word-chapter = Kapitel
byline = von { $author }
word-count-note = ca. { $count } Wörter
digit-group-separator = { "." }
