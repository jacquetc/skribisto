# Words the exporter writes into a book in this language. See en.ftl.

heading-book = Bok { $n }
heading-part = Del { $n }
heading-chapter = Kapittel { $n }
heading-word-book = Bok
heading-word-part = Del
heading-word-chapter = Kapittel
byline = av { $author }
word-count-note = ca. { $count } ord
digit-group-separator = { "\u00A0" }
