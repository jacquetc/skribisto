# Words the exporter writes into a book in this language. See en.ftl.

heading-book = ספר { $n }
heading-part = חלק { $n }
heading-chapter = פרק { $n }
heading-word-book = ספר
heading-word-part = חלק
heading-word-chapter = פרק
byline = מאת { $author }
word-count-note = כ-{ $count } מילים
digit-group-separator = { "," }
